//@version=6
indicator("Fibonacci Dual Grid (Pro Custom)", shorttitle="Fib Dual Grid Pro v6", overlay=true, max_lines_count=500, max_labels_count=500)

// ══════════════════════════════════════════════════════════════════════════════
// 1. ОБЩИЕ НАСТРОЙКИ
// ══════════════════════════════════════════════════════════════════════════════
grp_gen    = "⚙️ Общие настройки"
i_mode     = input.string("Авто (по тренду)", "Режим торговли", options=["Авто (по тренду)", "Только LONG", "Только SHORT", "Оба направления (L+S)"], group=grp_gen)
use_log    = input.bool(true, "Логарифмическая шкала (Log Fib)", group=grp_gen)

// ══════════════════════════════════════════════════════════════════════════════
// 2. СТАРШАЯ (ГЛОБАЛЬНАЯ) ФИБА — НАСТРОЙКИ И ОТОБРАЖЕНИЕ
// ══════════════════════════════════════════════════════════════════════════════
grp_maj_set = "🏛️ Старшая Фиба: Поиск и Позиция"
show_maj    = input.bool(true, "Показывать Старшую Фибу", group=grp_maj_set)
maj_min_p   = input.float(5.0, "Мин. размах Старшей (%)", minval=1.0, step=0.5, group=grp_maj_set)
maj_lookb   = input.int(100, "Глубина поиска Старшей (свечей)", minval=20, maxval=300, group=grp_maj_set)
maj_lbl_pos = input.string("Справа", "Расположение подписей Старшей", options=["Справа", "Слева"], group=grp_maj_set)

grp_maj_col = "🎨 Старшая Фиба: Цвета и Толщина уровней"
col_maj_000 = input.color(color.gray, "0.000 (Top/Bottom)", group=grp_maj_col)
w_maj_000   = input.int(1, "Толщина 0.000", minval=1, maxval=4, group=grp_maj_col)

col_maj_023 = input.color(color.teal, "0.236 (Тейк-2)", group=grp_maj_col)
w_maj_023   = input.int(1, "Толщина 0.236", minval=1, maxval=4, group=grp_maj_col)

col_maj_038 = input.color(color.green, "0.382 (Тейк-1)", group=grp_maj_col)
w_maj_038   = input.int(2, "Толщина 0.382", minval=1, maxval=4, group=grp_maj_col)

col_maj_050 = input.color(#3b82f6, "0.500 (Вход-1)", group=grp_maj_col)
w_maj_050   = input.int(2, "Толщина 0.500", minval=1, maxval=4, group=grp_maj_col)

col_maj_061 = input.color(color.blue, "0.618 (Вход-2)", group=grp_maj_col)
w_maj_061   = input.int(2, "Толщина 0.618", minval=1, maxval=4, group=grp_maj_col)

col_maj_078 = input.color(color.purple, "0.786 (Вход-3)", group=grp_maj_col)
w_maj_078   = input.int(1, "Толщина 0.786", minval=1, maxval=4, group=grp_maj_col)

col_maj_086 = input.color(color.red, "0.860 (Стоп-Лосс)", group=grp_maj_col)
w_maj_086   = input.int(2, "Толщина 0.860", minval=1, maxval=4, group=grp_maj_col)

col_maj_100 = input.color(color.maroon, "1.000 (Дно/Вершина)", group=grp_maj_col)
w_maj_100   = input.int(2, "Толщина 1.000", minval=1, maxval=4, group=grp_maj_col)

col_maj_161 = input.color(color.fuchsia, "1.618 (Манипуляция)", group=grp_maj_col)
w_maj_161   = input.int(2, "Толщина 1.618", minval=1, maxval=4, group=grp_maj_col)

col_maj_200 = input.color(color.orange, "2.000 (Добор DCA)", group=grp_maj_col)
w_maj_200   = input.int(2, "Толщина 2.000", minval=1, maxval=4, group=grp_maj_col)

// ══════════════════════════════════════════════════════════════════════════════
// 3. МЛАДШАЯ (ЛОКАЛЬНАЯ) ФИБА — НАСТРОЙКИ И ОТОБРАЖЕНИЕ
// ══════════════════════════════════════════════════════════════════════════════
grp_min_set = "⚡ Младшая Фиба: Поиск"
show_min    = input.bool(true, "Показывать Младшую Фибу", group=grp_min_set)
min_min_p   = input.float(2.0, "Мин. размах Младшей (%)", minval=0.5, step=0.5, group=grp_min_set)
min_lookb   = input.int(36, "Глубина поиска Младшей (свечей)", minval=10, maxval=100, group=grp_min_set)

grp_min_col = "🎨 Младшая Фиба: Цвета и Толщина уровней"
col_min_038 = input.color(color.lime, "0.382 (Тейк)", group=grp_min_col)
w_min_038   = input.int(1, "Толщина 0.382", minval=1, maxval=4, group=grp_min_col)

col_min_050 = input.color(#06b6d4, "0.500 (Вход)", group=grp_min_col)
w_min_050   = input.int(2, "Толщина 0.500", minval=1, maxval=4, group=grp_min_col)

col_min_061 = input.color(color.yellow, "0.618 (Вход)", group=grp_min_col)
w_min_061   = input.int(2, "Толщина 0.618", minval=1, maxval=4, group=grp_min_col)

col_min_078 = input.color(#c084fc, "0.786 (Глубокий Вход)", group=grp_min_col)
w_min_078   = input.int(1, "Толщина 0.786", minval=1, maxval=4, group=grp_min_col)

col_min_086 = input.color(color.red, "0.860 (Стоп)", group=grp_min_col)
w_min_086   = input.int(1, "Толщина 0.860", minval=1, maxval=4, group=grp_min_col)

col_min_100 = input.color(color.maroon, "1.000 (Дно)", group=grp_min_col)
w_min_100   = input.int(1, "Толщина 1.000", minval=1, maxval=4, group=grp_min_col)

col_min_161 = input.color(#e879f9, "1.618 (Манипуляция)", group=grp_min_col)
w_min_161   = input.int(2, "Толщина 1.618", minval=1, maxval=4, group=grp_min_col)

col_min_200 = input.color(#fb923c, "2.000 (Добор DCA)", group=grp_min_col)
w_min_200   = input.int(2, "Толщина 2.000", minval=1, maxval=4, group=grp_min_col)

// ══════════════════════════════════════════════════════════════════════════════
// 4. ТУМБЛЕРЫ ВКЛЮЧЕНИЯ/ВЫКЛЮЧЕНИЯ УРОВНЕЙ
// ══════════════════════════════════════════════════════════════════════════════
grp_lvls    = "👁️ Включение/Выключение уровней"
show_0236   = input.bool(true, "Показывать 0.236 Fib (Дальний Тейк)", group=grp_lvls)
show_0382   = input.bool(true, "Показывать 0.382 Fib (Базовый Тейк)", group=grp_lvls)
show_0786   = input.bool(true, "Показывать 0.786 Fib (Глубокий Вход)", group=grp_lvls)
show_0860   = input.bool(true, "Показывать 0.860 Fib (Стоп-Лосс)", group=grp_lvls)
show_manip  = input.bool(true, "Показывать 1.618 / 2.000 (Манипуляция)", group=grp_lvls)

// ══════════════════════════════════════════════════════════════════════════════
// 5. МАТЕМАТИЧЕСКИЕ ФУНКЦИИ И ОТРИСОВКА
// ══════════════════════════════════════════════════════════════════════════════
calc_fib_long(float h, float l, float lvl, bool is_log) =>
    if is_log and h > 0 and l > 0
        math.exp(math.log(h) - lvl * (math.log(h) - math.log(l)))
    else
        h - lvl * (h - l)

calc_fib_short(float h, float l, float lvl, bool is_log) =>
    if is_log and h > 0 and l > 0
        math.exp(math.log(l) + lvl * (math.log(h) - math.log(l)))
    else
        l + lvl * (h - l)

draw_level(float price, float lvl, string name, string pref, color col, int width, string style_type, int x_start, int x_end, string label_align, line[] lines_arr, label[] labels_arr) =>
    var line_style = line.style_solid
    if style_type == "dashed"
        line_style := line.style_dashed
    else if style_type == "dotted"
        line_style := line.style_dotted

    line ln = line.new(x_start, price, x_end, price, color=col, width=width, style=line_style)
    array.push(lines_arr, ln)
    
    string txt = pref + name + " (" + str.tostring(lvl, "#.###") + ") = " + str.tostring(price, "#.###") + " $"
    int lx = label_align == "Слева" ? x_start : x_end
    var l_style = label_align == "Слева" ? label.style_label_right : label.style_label_left
    
    label lb = label.new(lx, price, txt, style=l_style, color=color.new(color.black, 100), textcolor=col, size=size.small)
    array.push(labels_arr, lb)

// ══════════════════════════════════════════════════════════════════════════════
// 6. ПОИСК ИМПУЛЬСОВ
// ══════════════════════════════════════════════════════════════════════════════
find_long_impulse(int lookback, float min_pct) =>
    int   best_start = na
    float best_low   = na
    float best_high  = na
    float best_pct   = 0.0
    int   max_s      = math.min(lookback, bar_index)

    if max_s >= 2
        for s = max_s to 1
            float l = low[s]
            float h = high[s]
            int peak_bar = s
            bool broken = false
            bool growth = false

            for k = s - 1 to 0
                float cur_05 = calc_fib_long(h, l, 0.500, use_log)
                if low[k] <= cur_05
                    peak_bar := k + 1
                    break
                if low[k] < l
                    broken := true
                    break
                if high[k] > h
                    h := high[k]
                    peak_bar := k
                    growth := true

            if not broken and growth and peak_bar < s
                float sl_86 = calc_fib_long(h, l, 0.860, use_log)
                bool sl_hit = false
                if peak_bar > 0
                    for p = peak_bar - 1 to 0
                        if low[p] <= sl_86 or low[p] < l
                            sl_hit := true
                            break
                
                if not sl_hit
                    float pct = (h - l) / l * 100.0
                    if pct >= min_pct and (pct > best_pct or na(best_pct))
                        best_pct   := pct
                        best_start := bar_index - s
                        best_low   := l
                        best_high  := h

    [best_start, best_low, best_high, best_pct]

find_short_impulse(int lookback, float min_pct) =>
    int   best_start = na
    float best_high  = na
    float best_low   = na
    float best_pct   = 0.0
    int   max_s      = math.min(lookback, bar_index)

    if max_s >= 2
        for s = max_s to 1
            float h = high[s]
            float l = low[s]
            int bottom_bar = s
            bool broken = false
            bool drop   = false

            for k = s - 1 to 0
                float cur_05 = calc_fib_short(h, l, 0.500, use_log)
                if high[k] >= cur_05
                    bottom_bar := k + 1
                    break
                if high[k] > h
                    broken := true
                    break
                if low[k] < l
                    l := low[k]
                    drop := true
                    bottom_bar := k

            if not broken and drop and bottom_bar < s
                float sl_86 = calc_fib_short(h, l, 0.860, use_log)
                bool sl_hit = false
                if bottom_bar > 0
                    for p = bottom_bar - 1 to 0
                        if high[p] >= sl_86 or high[p] > h
                            sl_hit := true
                            break
                
                if not sl_hit
                    float pct = (h - l) / h * 100.0
                    if pct >= min_pct and (pct > best_pct or na(best_pct))
                        best_pct   := pct
                        best_start := bar_index - s
                        best_high  := h
                        best_low   := l

    [best_start, best_high, best_low, best_pct]

// ══════════════════════════════════════════════════════════════════════════════
// 7. ОТРИСОВКА СЕТОК (СТРОГО НА ПОСЛЕДНЕМ БАРЕ)
// ══════════════════════════════════════════════════════════════════════════════
var line[] lines_arr   = array.new_line()
var label[] labels_arr = array.new_label()

if barstate.islast
    for ln in lines_arr
        line.delete(ln)
    lines_arr.clear()
    for lb in labels_arr
        label.delete(lb)
    labels_arr.clear()

    // Запуск поиска только на последней свече
    [maj_l_s, maj_l_low, maj_l_high, maj_l_pct] = find_long_impulse(maj_lookb, maj_min_p)
    [min_l_s, min_l_low, min_l_high, min_l_pct] = find_long_impulse(min_lookb, min_min_p)

    [maj_s_s, maj_s_high, maj_s_low, maj_s_pct] = find_short_impulse(maj_lookb, maj_min_p)
    [min_s_s, min_s_high, min_s_low, min_s_pct] = find_short_impulse(min_lookb, min_min_p)

    bool allow_long  = (i_mode == "Только LONG") or (i_mode == "Оба направления (L+S)") or (i_mode == "Авто (по тренду)" and (na(maj_s_pct) or maj_l_pct >= maj_s_pct))
    bool allow_short = (i_mode == "Только SHORT") or (i_mode == "Оба направления (L+S)") or (i_mode == "Авто (по тренду)" and (na(maj_l_pct) or maj_s_pct > maj_l_pct))

    int x_end = bar_index + 14

    // ── 1. LONG СЕТКИ ──
    if allow_long
        // 🏛️ Старшая Long
        if show_maj and not na(maj_l_high) and not na(maj_l_low)
            float h = maj_l_high, float l = maj_l_low, int x_start = maj_l_s
            string pref = "🏛️ СТАРШАЯ: "
            draw_level(calc_fib_long(h, l, 0.000, use_log), 0.000, "TOP (High)", pref, col_maj_000, w_maj_000, "dashed", x_start, x_end, maj_lbl_pos, lines_arr, labels_arr)
            if show_0236
                draw_level(calc_fib_long(h, l, 0.236, use_log), 0.236, "🎯 Тейк-2", pref, col_maj_023, w_maj_023, "dotted", x_start, x_end, maj_lbl_pos, lines_arr, labels_arr)
            if show_0382
                draw_level(calc_fib_long(h, l, 0.382, use_log), 0.382, "🎯 Тейк-1", pref, col_maj_038, w_maj_038, "solid", x_start, x_end, maj_lbl_pos, lines_arr, labels_arr)
            draw_level(calc_fib_long(h, l, 0.500, use_log), 0.500, "🔹 Вход-1", pref, col_maj_050, w_maj_050, "solid", x_start, x_end, maj_lbl_pos, lines_arr, labels_arr)
            draw_level(calc_fib_long(h, l, 0.618, use_log), 0.618, "🔹 Вход-2", pref, col_maj_061, w_maj_061, "solid", x_start, x_end, maj_lbl_pos, lines_arr, labels_arr)
            if show_0786
                draw_level(calc_fib_long(h, l, 0.786, use_log), 0.786, "⚡ Вход-3", pref, col_maj_078, w_maj_078, "dotted", x_start, x_end, maj_lbl_pos, lines_arr, labels_arr)
            if show_0860
                draw_level(calc_fib_long(h, l, 0.860, use_log), 0.860, "🛑 Стоп", pref, col_maj_086, w_maj_086, "dashed", x_start, x_end, maj_lbl_pos, lines_arr, labels_arr)
            draw_level(calc_fib_long(h, l, 1.000, use_log), 1.000, "🛑 Дно Low", pref, col_maj_100, w_maj_100, "solid", x_start, x_end, maj_lbl_pos, lines_arr, labels_arr)
            if show_manip
                draw_level(calc_fib_long(h, l, 1.618, use_log), 1.618, "🟣 Манипуляция", pref, col_maj_161, w_maj_161, "solid", x_start, x_end, maj_lbl_pos, lines_arr, labels_arr)
                draw_level(calc_fib_long(h, l, 2.000, use_log), 2.000, "🟠 Добор DCA", pref, col_maj_200, w_maj_200, "solid", x_start, x_end, maj_lbl_pos, lines_arr, labels_arr)

        // ⚡ Младшая Long
        bool is_diff_l = na(maj_l_s) or (min_l_s != maj_l_s) or (math.abs(min_l_low - maj_l_low) > 0.0001)
        if show_min and not na(min_l_high) and not na(min_l_low) and is_diff_l
            float h = min_l_high, float l = min_l_low, int x_start = min_l_s
            string pref = "⚡ МЛАДШАЯ: "
            if show_0382
                draw_level(calc_fib_long(h, l, 0.382, use_log), 0.382, "🎯 Тейк (0.382)", pref, col_min_038, w_min_038, "dotted", x_start, x_end, "Справа", lines_arr, labels_arr)
            draw_level(calc_fib_long(h, l, 0.500, use_log), 0.500, "🔹 Вход (0.500)", pref, col_min_050, w_min_050, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
            draw_level(calc_fib_long(h, l, 0.618, use_log), 0.618, "🔹 Вход (0.618)", pref, col_min_061, w_min_061, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
            if show_0786
                draw_level(calc_fib_long(h, l, 0.786, use_log), 0.786, "⚡ Вход (0.786)", pref, col_min_078, w_min_078, "dotted", x_start, x_end, "Справа", lines_arr, labels_arr)
            if show_0860
                draw_level(calc_fib_long(h, l, 0.860, use_log), 0.860, "🛑 Стоп (0.860)", pref, col_min_086, w_min_086, "dashed", x_start, x_end, "Справа", lines_arr, labels_arr)
            draw_level(calc_fib_long(h, l, 1.000, use_log), 1.000, "🛑 Дно", pref, col_min_100, w_min_100, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
            if show_manip
                draw_level(calc_fib_long(h, l, 1.618, use_log), 1.618, "🟣 Манипуляция (1.618)", pref, col_min_161, w_min_161, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
                draw_level(calc_fib_long(h, l, 2.000, use_log), 2.000, "🟠 Добор (2.000)", pref, col_min_200, w_min_200, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)

    // ── 2. SHORT СЕТКИ ──
    if allow_short
        // 🏛️ Старшая Short
        if show_maj and not na(maj_s_high) and not na(maj_s_low)
            float h = maj_s_high, float l = maj_s_low, int x_start = maj_s_s
            string pref = "🏛️ СТАРШИЙ SHORT: "
            draw_level(calc_fib_short(h, l, 0.000, use_log), 0.000, "BOTTOM (Low)", pref, col_maj_000, w_maj_000, "dashed", x_start, x_end, maj_lbl_pos, lines_arr, labels_arr)
            if show_0236
                draw_level(calc_fib_short(h, l, 0.236, use_log), 0.236, "🎯 Тейк-2", pref, col_maj_023, w_maj_023, "dotted", x_start, x_end, maj_lbl_pos, lines_arr, labels_arr)
            if show_0382
                draw_level(calc_fib_short(h, l, 0.382, use_log), 0.382, "🎯 Тейк-1", pref, col_maj_038, w_maj_038, "solid", x_start, x_end, maj_lbl_pos, lines_arr, labels_arr)
            draw_level(calc_fib_short(h, l, 0.500, use_log), 0.500, "🔹 Вход в Short", pref, col_maj_050, w_maj_050, "solid", x_start, x_end, maj_lbl_pos, lines_arr, labels_arr)
            draw_level(calc_fib_short(h, l, 0.618, use_log), 0.618, "🔹 Вход в Short", pref, col_maj_061, w_maj_061, "solid", x_start, x_end, maj_lbl_pos, lines_arr, labels_arr)
            if show_0786
                draw_level(calc_fib_short(h, l, 0.786, use_log), 0.786, "⚡ Вход-3", pref, col_maj_078, w_maj_078, "dotted", x_start, x_end, maj_lbl_pos, lines_arr, labels_arr)
            if show_0860
                draw_level(calc_fib_short(h, l, 0.860, use_log), 0.860, "🛑 Стоп Short", pref, col_maj_086, w_maj_086, "dashed", x_start, x_end, maj_lbl_pos, lines_arr, labels_arr)
            draw_level(calc_fib_short(h, l, 1.000, use_log), 1.000, "🛑 Вершина High", pref, col_maj_100, w_maj_100, "solid", x_start, x_end, maj_lbl_pos, lines_arr, labels_arr)
            if show_manip
                draw_level(calc_fib_short(h, l, 1.618, use_log), 1.618, "🟣 Short Манипуляция", pref, col_maj_161, w_maj_161, "solid", x_start, x_end, maj_lbl_pos, lines_arr, labels_arr)
                draw_level(calc_fib_short(h, l, 2.000, use_log), 2.000, "🟠 Добор DCA Short", pref, col_maj_200, w_maj_200, "solid", x_start, x_end, maj_lbl_pos, lines_arr, labels_arr)

        // ⚡ Младшая Short
        bool is_diff_s = na(maj_s_s) or (min_s_s != maj_s_s) or (math.abs(min_s_high - maj_s_high) > 0.0001)
        if show_min and not na(min_s_high) and not na(min_s_low) and is_diff_s
            float h = min_s_high, float l = min_s_low, int x_start = min_s_s
            string pref = "⚡ МЛАДШИЙ SHORT: "
            if show_0382
                draw_level(calc_fib_short(h, l, 0.382, use_log), 0.382, "🎯 Тейк (0.382)", pref, col_min_038, w_min_038, "dotted", x_start, x_end, "Справа", lines_arr, labels_arr)
            draw_level(calc_fib_short(h, l, 0.500, use_log), 0.500, "🔹 Вход (0.500)", pref, col_min_050, w_min_050, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
