//@version=6
indicator("Fibonacci Dual Grid (Pro Style v6)", shorttitle="Fib Dual Grid (Style v6)", overlay=true, max_lines_count=500, max_labels_count=500)

// ══════════════════════════════════════════════════════════════════════════════
// 1. НАСТРОЙКИ (ВКЛАДКА "АРГУМЕНТЫ / INPUTS")
// ══════════════════════════════════════════════════════════════════════════════
grp_gen    = "⚙️ Режим торговли"
i_mode     = input.string("Авто (по тренду)", "Направление", options=["Авто (по тренду)", "Только LONG", "Только SHORT", "Оба направления (L+S)"], group=grp_gen)
use_log    = input.bool(true, "Логарифмическая шкала (Log Fib)", group=grp_gen)

grp_maj_set = "🏛️ Старшая (Глобальная) Фиба"
show_maj    = input.bool(true, "Искать Старшую Фибу", group=grp_maj_set)
maj_min_p   = input.float(5.0, "Мин. размах Старшей (%)", minval=1.0, step=0.5, group=grp_maj_set)
maj_lookb   = input.int(100, "Глубина поиска Старшей (свечей)", minval=20, maxval=300, group=grp_maj_set)
maj_lbl_pos = input.string("Справа", "Подписи Старшей", options=["Справа", "Слева"], group=grp_maj_set)

grp_min_set = "⚡ Младшая (Локальная) Фиба"
show_min    = input.bool(true, "Искать Младшую Фибу", group=grp_min_set)
min_min_p   = input.float(2.0, "Мин. размах Младшей (%)", minval=0.5, step=0.5, group=grp_min_set)
min_lookb   = input.int(36, "Глубина поиска Младшей (свечей)", minval=10, maxval=100, group=grp_min_set)

// ══════════════════════════════════════════════════════════════════════════════
// 2. МАТЕМАТИЧЕСКИЕ ФУНКЦИИ
// ══════════════════════════════════════════════════════════════════════════════
calc_fib_long(float h, float l, float lvl, bool is_log) =>
    if is_log and h > 0 and l > 0
        math.exp(math.log(h) - lvl * (math.log(h) - math.log(l)))
    else
        h - lvl * (h - l)

calc_fib_short(float h, float l, float lvl, bool is_log) =>
    if is_log and h > 0 and l > 0
        math.exp(math.log(l) + lvl * (math.log(h) - math.log(l)))
    else
        l + lvl * (h - l)

// ══════════════════════════════════════════════════════════════════════════════
// 3. ПОИСК ИМПУЛЬСОВ
// ══════════════════════════════════════════════════════════════════════════════
find_long_impulse(int lookback, float min_pct) =>
    int   best_start = na
    float best_low   = na
    float best_high  = na
    float best_pct   = 0.0
    int   max_s      = math.min(lookback, bar_index)

    if max_s >= 2
        for s = max_s to 1
            float l = low[s]
            float h = high[s]
            int peak_bar = s
            bool broken = false
            bool growth = false

            for k = s - 1 to 0
                float cur_05 = calc_fib_long(h, l, 0.500, use_log)
                if low[k] <= cur_05
                    peak_bar := k + 1
                    break
                if low[k] < l
                    broken := true
                    break
                if high[k] > h
                    h := high[k]
                    peak_bar := k
                    growth := true

            if not broken and growth and peak_bar < s
                float sl_86 = calc_fib_long(h, l, 0.860, use_log)
                bool sl_hit = false
                if peak_bar > 0
                    for p = peak_bar - 1 to 0
                        if low[p] <= sl_86 or low[p] < l
                            sl_hit := true
                            break
                
                if not sl_hit
                    float pct = (h - l) / l * 100.0
                    if pct >= min_pct and (pct > best_pct or na(best_pct))
                        best_pct   := pct
                        best_start := bar_index - s
                        best_low   := l
                        best_high  := h

    [best_start, best_low, best_high, best_pct]

find_short_impulse(int lookback, float min_pct) =>
    int   best_start = na
    float best_high  = na
    float best_low   = na
    float best_pct   = 0.0
    int   max_s      = math.min(lookback, bar_index)

    if max_s >= 2
        for s = max_s to 1
            float h = high[s]
            float l = low[s]
            int bottom_bar = s
            bool broken = false
            bool drop   = false

            for k = s - 1 to 0
                float cur_05 = calc_fib_short(h, l, 0.500, use_log)
                if high[k] >= cur_05
                    bottom_bar := k + 1
                    break
                if high[k] > h
                    broken := true
                    break
                if low[k] < l
                    l := low[k]
                    drop := true
                    bottom_bar := k

            if not broken and drop and bottom_bar < s
                float sl_86 = calc_fib_short(h, l, 0.860, use_log)
                bool sl_hit = false
                if bottom_bar > 0
                    for p = bottom_bar - 1 to 0
                        if high[p] >= sl_86 or high[p] > h
                            sl_hit := true
                            break
                
                if not sl_hit
                    float pct = (h - l) / h * 100.0
                    if pct >= min_pct and (pct > best_pct or na(best_pct))
                        best_pct   := pct
                        best_start := bar_index - s
                        best_high  := h
                        best_low   := l

    [best_start, best_high, best_low, best_pct]

// ══════════════════════════════════════════════════════════════════════════════
// 4. ВЫЧИСЛЕНИЕ УРОВНЕЙ ДЛЯ ВКЛАДКИ "СТИЛЬ" (STYLE)
// ══════════════════════════════════════════════════════════════════════════════
var float maj_p000 = na, var float maj_p023 = na, var float maj_p038 = na, var float maj_p050 = na, var float maj_p061 = na, var float maj_p078 = na, var float maj_p086 = na, var float maj_p100 = na, var float maj_p161 = na, var float maj_p200 = na
var float min_p038 = na, var float min_p050 = na, var float min_p061 = na, var float min_p078 = na, var float min_p086 = na, var float min_p100 = na, var float min_p161 = na, var float min_p200 = na

var label[] labels_arr = array.new_label()

if barstate.islast
    for lb in labels_arr
        label.delete(lb)
    labels_arr.clear()

    [maj_l_s, maj_l_low, maj_l_high, maj_l_pct] = find_long_impulse(maj_lookb, maj_min_p)
    [min_l_s, min_l_low, min_l_high, min_l_pct] = find_long_impulse(min_lookb, min_min_p)

    [maj_s_s, maj_s_high, maj_s_low, maj_s_pct] = find_short_impulse(maj_lookb, maj_min_p)
    [min_s_s, min_s_high, min_s_low, min_s_pct] = find_short_impulse(min_lookb, min_min_p)

    bool is_long  = (i_mode == "Только LONG") or (i_mode == "Авто (по тренду)" and (na(maj_s_pct) or maj_l_pct >= maj_s_pct))
    bool is_short = (i_mode == "Только SHORT") or (i_mode == "Авто (по тренду)" and (na(maj_l_pct) or maj_s_pct > maj_l_pct))

    int x_end = bar_index + 12

    // ── РАСЧЕТ СТАРШЕЙ ФИБЫ ──
    if show_maj
        if is_long and not na(maj_l_high) and not na(maj_l_low)
            float h = maj_l_high, float l = maj_l_low, int xs = maj_l_s
            maj_p000 := calc_fib_long(h, l, 0.000, use_log)
            maj_p023 := calc_fib_long(h, l, 0.236, use_log)
            maj_p038 := calc_fib_long(h, l, 0.382, use_log)
            maj_p050 := calc_fib_long(h, l, 0.500, use_log)
            maj_p061 := calc_fib_long(h, l, 0.618, use_log)
            maj_p078 := calc_fib_long(h, l, 0.786, use_log)
            maj_p086 := calc_fib_long(h, l, 0.860, use_log)
            maj_p100 := calc_fib_long(h, l, 1.000, use_log)
            maj_p161 := calc_fib_long(h, l, 1.618, use_log)
            maj_p200 := calc_fib_long(h, l, 2.000, use_log)

            int lx = maj_lbl_pos == "Слева" ? xs : x_end
            var ls = maj_lbl_pos == "Слева" ? label.style_label_right : label.style_label_left
            array.push(labels_arr, label.new(lx, maj_p050, "🏛️ СТАРШАЯ 0.500: " + str.tostring(maj_p050, "#.###"), style=ls, color=color.new(color.black, 100), textcolor=#3b82f6, size=size.small))
            array.push(labels_arr, label.new(lx, maj_p061, "🏛️ СТАРШАЯ 0.618: " + str.tostring(maj_p061, "#.###"), style=ls, color=color.new(color.black, 100), textcolor=color.blue, size=size.small))
        
        else if is_short and not na(maj_s_high) and not na(maj_s_low)
            float h = maj_s_high, float l = maj_s_low, int xs = maj_s_s
            maj_p000 := calc_fib_short(h, l, 0.000, use_log)
            maj_p023 := calc_fib_short(h, l, 0.236, use_log)
            maj_p038 := calc_fib_short(h, l, 0.382, use_log)
            maj_p050 := calc_fib_short(h, l, 0.500, use_log)
            maj_p061 := calc_fib_short(h, l, 0.618, use_log)
            maj_p078 := calc_fib_short(h, l, 0.786, use_log)
            maj_p086 := calc_fib_short(h, l, 0.860, use_log)
            maj_p100 := calc_fib_short(h, l, 1.000, use_log)
            maj_p161 := calc_fib_short(h, l, 1.618, use_log)
            maj_p200 := calc_fib_short(h, l, 2.000, use_log)

            int lx = maj_lbl_pos == "Слева" ? xs : x_end
            var ls = maj_lbl_pos == "Слева" ? label.style_label_right : label.style_label_left
            array.push(labels_arr, label.new(lx, maj_p050, "🏛️ SHORT 0.500: " + str.tostring(maj_p050, "#.###"), style=ls, color=color.new(color.black, 100), textcolor=#3b82f6, size=size.small))
            array.push(labels_arr, label.new(lx, maj_p061, "🏛️ SHORT 0.618: " + str.tostring(maj_p061, "#.###"), style=ls, color=color.new(color.black, 100), textcolor=color.blue, size=size.small))

    // ── РАСЧЕТ МЛАДШЕЙ ФИБЫ ──
    if show_min
        if is_long and not na(min_l_high) and not na(min_l_low)
            float h = min_l_high, float l = min_l_low
            min_p038 := calc_fib_long(h, l, 0.382, use_log)
            min_p050 := calc_fib_long(h, l, 0.500, use_log)
            min_p061 := calc_fib_long(h, l, 0.618, use_log)
            min_p078 := calc_fib_long(h, l, 0.786, use_log)
            min_p086 := calc_fib_long(h, l, 0.860, use_log)
            min_p100 := calc_fib_long(h, l, 1.000, use_log)
            min_p161 := calc_fib_long(h, l, 1.618, use_log)
            min_p200 := calc_fib_long(h, l, 2.000, use_log)

            array.push(labels_arr, label.new(x_end, min_p050, "⚡ МЛАДШАЯ 0.500: " + str.tostring(min_p050, "#.###"), style=label.style_label_left, color=color.new(color.black, 100), textcolor=#06b6d4, size=size.small))
            array.push(labels_arr, label.new(x_end, min_p061, "⚡ МЛАДШАЯ 0.618: " + str.tostring(min_p061, "#.###"), style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.yellow, size=size.small))
            
        else if is_short and not na(min_s_high) and not na(min_s_low)
            float h = min_s_high, float l = min_s_low
            min_p038 := calc_fib_short(h, l, 0.382, use_log)
            min_p050 := calc_fib_short(h, l, 0.500, use_log)
            min_p061 := calc_fib_short(h, l, 0.618, use_log)
            min_p078 := calc_fib_short(h, l, 0.786, use_log)
            min_p086 := calc_fib_short(h, l, 0.860, use_log)
            min_p100 := calc_fib_short(h, l, 1.000, use_log)
            min_p161 := calc_fib_short(h, l, 1.618, use_log)
            min_p200 := calc_fib_short(h, l, 2.000, use_log)

            array.push(labels_arr, label.new(x_end, min_p050, "⚡ SHORT 0.500: " + str.tostring(min_p050, "#.###"), style=label.style_label_left, color=color.new(color.black, 100), textcolor=#06b6d4, size=size.small))
            array.push(labels_arr, label.new(x_end, min_p061, "⚡ SHORT 0.618: " + str.tostring(min_p061, "#.###"), style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.yellow, size=size.small))

// ══════════════════════════════════════════════════════════════════════════════
// 5. НАТИВНЫЕ ЛИНИИ TRADINGVIEW (УПРАВЛЯЮТСЯ ВО ВКЛАДКЕ "СТИЛЬ" / STYLE)
// ══════════════════════════════════════════════════════════════════════════════

// ── 🏛️ СТАРШАЯ ФИБА В СТИЛЕ ──
plot(maj_p000, title="🏛️ Старшая: 0.000 Top/Bottom", color=color.gray, linewidth=1, style=plot.style_linebr)
plot(maj_p023, title="🏛️ Старшая: 0.236 Тейк-2",     color=color.teal, linewidth=1, style=plot.style_linebr)
plot(maj_p038, title="🏛️ Старшая: 0.382 Тейк-1",     color=color.green, linewidth=2, style=plot.style_linebr)
plot(maj_p050, title="🏛️ Старшая: 0.500 Вход-1",     color=#3b82f6, linewidth=2, style=plot.style_linebr)
plot(maj_p061, title="🏛️ Старшая: 0.618 Вход-2",     color=color.blue, linewidth=2, style=plot.style_linebr)
plot(maj_p078, title="🏛️ Старшая: 0.786 Вход-3",     color=color.purple, linewidth=1, style=plot.style_linebr)
plot(maj_p086, title="🏛️ Старшая: 0.860 Стоп-Лосс",  color=color.red, linewidth=2, style=plot.style_linebr)
plot(maj_p100, title="🏛️ Старшая: 1.000 Дно/Вершина", color=color.maroon, linewidth=2, style=plot.style_linebr)
plot(maj_p161, title="🏛️ Старшая: 1.618 Манипуляция", color=color.fuchsia, linewidth=2, style=plot.style_linebr)
plot(maj_p200, title="🏛️ Старшая: 2.000 Добор DCA",  color=color.orange, linewidth=2, style=plot.style_linebr)

// ── ⚡ МЛАДШАЯ ФИБА В СТИЛЕ ──
plot(min_p038, title="⚡ Младшая: 0.382 Тейк",        color=color.lime, linewidth=1, style=plot.style_linebr)
plot(min_p050, title="⚡ Младшая: 0.500 Вход",        color=#06b6d4, linewidth=2, style=plot.style_linebr)
plot(min_p061, title="⚡ Младшая: 0.618 Вход",        color=color.yellow, linewidth=2, style=plot.style_linebr)
plot(min_p078, title="⚡ Младшая: 0.786 Вход-3",      color=#c084fc, linewidth=1, style=plot.style_linebr)
plot(min_p086, title="⚡ Младшая: 0.860 Стоп",        color=color.red, linewidth=1, style=plot.style_linebr)
plot(min_p100, title="⚡ Младшая: 1.000 Дно",         color=color.maroon, linewidth=1, style=plot.style_linebr)
plot(min_p161, title="⚡ Младшая: 1.618 Манипуляция", color=#e879f9, linewidth=2, style=plot.style_linebr)
plot(min_p200, title="⚡ Младшая: 2.000 Добор DCA",   color=#fb923c, linewidth=2, style=plot.style_linebr)
