// ══════════════════════════════════════════════════════════════════════════════
// 5. МАТЕМАТИЧЕСКИЕ ФУНКЦИИ И ОТРИСОВКА
// ══════════════════════════════════════════════════════════════════════════════

// Форматирование цен по правилам Bybit:
// Если цена >= 1.0 -> 3 знака после запятой (иначе Bybit выдает ошибку шага цены)
// Если цена < 1.0 -> 4 знака после запятой
fmt_p(float price) =>
    if na(price)
        "—"
    else if price >= 1.0
        str.tostring(price, "#.###")
    else
        str.tostring(price, "#.####")

calc_fib_long(float h, float l, float lvl, bool is_log) =>
    if is_log and h > 0 and l > 0
        math.exp(math.log(h) - lvl * (math.log(h) - math.log(l)))
    else
        h - lvl * (h - l)

calc_fib_short(float h, float l, float lvl, bool is_log) =>
    if is_log and h > 0 and l > 0
        math.exp(math.log(l) + lvl * (math.log(h) - math.log(l)))
    else
        l + lvl * (h - l)

draw_level(float price, string label_text, color col, int width, string style_type, int x_start, int x_end, string label_align, line[] lines_arr, label[] labels_arr) =>
    var line_style = line.style_solid
    if style_type == "dashed"
        line_style := line.style_dashed
    else if style_type == "dotted"
        line_style := line.style_dotted

    line ln = line.new(x_start, price, x_end, price, xloc=xloc.bar_index, color=col, width=width, style=line_style)
    array.push(lines_arr, ln)
    
    int lx = label_align == "Слева" ? x_start : x_end
    var l_style = label_align == "Слева" ? label.style_label_right : label.style_label_left
    
    label lb = label.new(lx, price, label_text, xloc=xloc.bar_index, style=l_style, color=color.new(color.black, 100), textcolor=col, size=size.small)
    array.push(labels_arr, lb)

// ══════════════════════════════════════════════════════════════════════════════
// 6. НАДЕЖНЫЙ ПОИСК АКТИВНЫХ ИМПУЛЬСОВ (МАКРО-СВИНГ И ЛОКАЛЬНАЯ ФИБА)
// ══════════════════════════════════════════════════════════════════════════════

// Поиск Старшей (Макро) Фибы по структурным свингам
find_macro_long(int lookback, float min_pct) =>
    int   best_start = na
    float best_low   = na
    float best_high  = na
    float best_pct   = 0.0
    int   max_s      = math.min(lookback, bar_index)

    if max_s >= 5
        // Сканируем последние вершины
        for b = 1 to math.min(45, max_s - 2)
            float h = high[b]
            // b должна быть сформированной вершиной (не текущая развивающаяся свеча и выше b-1 / b+1)
            if high[b - 1] <= h and high[b + 1] <= h
                // Ищем базу импульса (самый низкий минимум перед взлетом в пределах 32 свечей до старта ралли)
                float cur_min_l = h
                int   cur_min_s = na
                int   scan_end  = math.min(b + 32, max_s)
                for s = b + 1 to scan_end
                    if low[s] < cur_min_l
                        cur_min_l := low[s]
                        cur_min_s := s
                
                if not na(cur_min_s)
                    float pct = (h - cur_min_l) / cur_min_l * 100.0
                    if pct >= min_pct
                        // Проверяем статус после вершины: максимум не должен быть перебит выше
                        bool broken_high = false
                        for p = b - 1 to 0
                            if high[p] > h
                                broken_high := true
                                break
                        if not broken_high
                            if pct > best_pct
                                best_pct   := pct
                                best_start := bar_index - cur_min_s
                                best_low   := cur_min_l
                                best_high  := h

    [best_start, best_low, best_high, best_pct]

find_macro_short(int lookback, float min_pct) =>
    int   best_start = na
    float best_high  = na
    float best_low   = na
    float best_pct   = 0.0
    int   max_s      = math.min(lookback, bar_index)

    if max_s >= 5
        for b = 1 to math.min(45, max_s - 2)
            float l = low[b]
            if low[b - 1] >= l and low[b + 1] >= l
                float cur_max_h = l
                int   cur_max_s = na
                int   scan_end  = math.min(b + 32, max_s)
                for s = b + 1 to scan_end
                    if high[s] > cur_max_h
                        cur_max_h := high[s]
                        cur_max_s := s
                
                if not na(cur_max_s)
                    float pct = (cur_max_h - l) / cur_max_h * 100.0
                    if pct >= min_pct
                        bool broken_low = false
                        for p = b - 1 to 0
                            if low[p] < l
                                broken_low := true
                                break
                        if not broken_low
                            if pct > best_pct
                                best_pct   := pct
                                best_start := bar_index - cur_max_s
                                best_high  := cur_max_h
                                best_low   := l

    [best_start, best_high, best_low, best_pct]

// Поиск Младшей (Локальной) Фибы по строгому правилу:
// 1. Начальная свеча s (low = l_s, high = h_s).
// 2. Импульс подтверждается ТОЛЬКО ЗАКРЫТЫМИ СВЕЧАМИ (до свечи 1 включительно).
// 3. Следующие закрытые свечи НЕ должны опускаться <= 0.500 первой свечи ДО первого закрытого пробоя ее High.
// 4. Пока НЕ БЫЛО входа на 0.500: если цена растет — продолжаем тянуть фибу и ждать откат!
// 5. Если БЫЛ вход на 0.500 (entered = true):
//    - Фибу стираем, когда цена обновляет пик (пробивает уровень 0 / High) или забирает тейк.
//    - Если цена падает ниже уровня 1.0 (Low базы), то при включенной манипуляции ждем прихода к 1.618 и отката до 0.500.
//    - Если пробивается стоп манипуляции (2.000 / 2.618) — фиба удаляется.
find_minor_long(int lookback, float min_pct, int max_duration) =>
    int   best_start = na
    float best_low   = na
    float best_high  = na
    float best_pct   = 0.0
    int   best_bars  = 0
    int   max_s      = math.min(lookback, bar_index)

    if max_s >= 3
        for s = max_s - 1 to 2
            // 🛡️ Фильтр: импульс не может начинаться с внутренней продолжающей свечи ралли (предыдущая свеча уже была бычьей и ниже)
            if s + 1 <= max_s and (low[s] > low[s + 1] and close[s + 1] > open[s + 1])
                continue

            float l_s = low[s]
            float h_s = high[s]
            float cur_h = h_s
            bool  is_impulse   = false
            bool  broken       = false
            bool  entered_05   = false
            bool  entered_0618 = false
            int   entry_k_05   = -1
            int   entry_k_0618 = -1
            int   end_idx      = s

            // Сканируем только закрытые свечи от s-1 до 1
            for k = s - 1 to 1
                if not is_impulse
                    if low[k] < l_s
                        broken := true
                        break
                    float fib_05_first = calc_fib_long(h_s, l_s, 0.500, use_log)
                    if low[k] <= fib_05_first
                        broken := true
                        break
                    if high[k] > h_s
                        is_impulse := true
                        cur_h := high[k]
                        end_idx := k
                else
                    if not entered_05
                        float fib_05_cur = calc_fib_long(cur_h, l_s, 0.500, use_log)
                        if low[k] <= fib_05_cur
                            // Вход на 0.500 состоялся!
                            entered_05 := true
                            entry_k_05 := k
                        else
                            // Входа на 0.5 еще не было — продолжаем тянуть фибу вслед за новыми максимумами
                            if high[k] > cur_h
                                cur_h := high[k]
                                end_idx := k
                    
                    if entered_05
                        float in_0618 = calc_fib_long(cur_h, l_s, 0.618, use_log)
                        float tp_0382 = calc_fib_long(cur_h, l_s, 0.382, use_log)
                        float tp_0236 = calc_fib_long(cur_h, l_s, 0.236, use_log)
                        float sl_lim = show_manip ? calc_fib_long(cur_h, l_s, 2.000, use_log) : calc_fib_long(cur_h, l_s, 0.860, use_log)
                        float tp_target = calc_fib_long(cur_h, l_s, 0.500, use_log)

                        if not entered_0618
                            if low[k] <= in_0618
                                entered_0618 := true
                                entry_k_0618 := k

                        // 1. Проверка взятия тейка:
                        // Если вошли оба ордера: сетка полностью закрыта, только когда закрыт Ордер 1 (TP 0.236 или пик cur_h)
                        // Если вошел только Ордер 1: закрывается на TP 0.236
                        int entry_ref = entered_0618 ? entry_k_05 : entry_k_05
                        bool tp_hit = (k < entry_ref and (high[k] >= tp_0236 or close[k] >= tp_0236 or high[k] >= cur_h or close[k] >= cur_h)) or
                                      (k == entry_ref and (close[k] >= tp_0236 or close[k] >= cur_h))
                        if tp_hit
                            broken := true
                            break
                        
                        // 2. Если упали ниже уровня 1.0 (l_s)
                        if low[k] < l_s
                            if show_manip
                                float manip_1618 = calc_fib_long(cur_h, l_s, 1.618, use_log)
                                if low[k] <= manip_1618 and (high[k] >= tp_target or close[k] >= tp_target)
                                    broken := true
                                    break
                            else
                                broken := true
                                break

                        // 3. Выбили предельный стоп
                        if low[k] <= sl_lim
                            broken := true
                            break
            
            // На текущей живой свече [0]:
            if is_impulse and not broken
                if not entered_05
                    if high[0] > cur_h
                        cur_h := high[0]
                        end_idx := 0
                    float fib_05_live = calc_fib_long(cur_h, l_s, 0.500, use_log)
                    if low[0] <= fib_05_live
                        entered_05 := true
                        entry_k_05 := 0
                else
                    float in_0618 = calc_fib_long(cur_h, l_s, 0.618, use_log)
                    float tp_0382 = calc_fib_long(cur_h, l_s, 0.382, use_log)
                    float tp_0236 = calc_fib_long(cur_h, l_s, 0.236, use_log)
                    if not entered_0618 and low[0] <= in_0618
                        entered_0618 := true
                        entry_k_0618 := 0
                    
                    int entry_live_ref = entered_0618 ? entry_k_05 : entry_k_05
                    bool tp_live_hit = (entry_live_ref > 0 and (high[0] >= tp_0236 or close[0] >= tp_0236 or high[0] >= cur_h or close[0] >= cur_h)) or
                                       (entry_live_ref == 0 and (close[0] >= tp_0236 or close[0] >= cur_h))
                    if tp_live_hit
                        broken := true
                    
                    if not broken
                        float sl_lim = show_manip ? calc_fib_long(cur_h, l_s, 2.000, use_log) : calc_fib_long(cur_h, l_s, 0.860, use_log)
                        if high[0] >= cur_h or close[0] >= cur_h or low[0] <= sl_lim
                            broken := true

            if is_impulse and not broken
                float pct = (cur_h - l_s) / l_s * 100.0
                if pct >= min_pct
                    if pct > best_pct
                        best_pct   := pct
                        best_start := bar_index - s
                        best_low   := l_s
                        best_high  := cur_h
                        best_bars  := s - end_idx + 1

    [best_start, best_low, best_high, best_pct, best_bars]

find_minor_short(int lookback, float min_pct, int max_duration) =>
    int   best_start = na
    float best_high  = na
    float best_low   = na
    float best_pct   = 0.0
    int   best_bars  = 0
    int   max_s      = math.min(lookback, bar_index)

    if max_s >= 3
        for s = max_s - 1 to 2
            // 🛡️ Фильтр: дамп не может начинаться с внутренней продолжающей медвежьей свечи (предыдущая свеча уже была красной и выше)
            if s + 1 <= max_s and (high[s] < high[s + 1] and close[s + 1] < open[s + 1])
                continue

            float h_s = high[s]
            float l_s = low[s]
            float cur_l = l_s
            bool  is_dump     = false
            bool  broken      = false
            bool  entered_05   = false
            bool  entered_0618 = false
            int   entry_k_05   = -1
            int   entry_k_0618 = -1
            int   end_idx      = s

            for k = s - 1 to 1
                if not is_dump
                    if high[k] > h_s
                        broken := true
                        break
                    float fib_05_first = calc_fib_short(h_s, l_s, 0.500, use_log)
                    if high[k] >= fib_05_first
                        broken := true
                        break
                    if low[k] < l_s
                        is_dump := true
                        cur_l := low[k]
                        end_idx := k
                else
                    if not entered_05
                        float fib_05_cur = calc_fib_short(h_s, cur_l, 0.500, use_log)
                        if high[k] >= fib_05_cur
                            entered_05 := true
                            entry_k_05 := k
                        else
                            if low[k] < cur_l
                                cur_l := low[k]
                                end_idx := k
                    
                    if entered_05
                        float in_0618 = calc_fib_short(h_s, cur_l, 0.618, use_log)
                        float tp_0382 = calc_fib_short(h_s, cur_l, 0.382, use_log)
                        float tp_0236 = calc_fib_short(h_s, cur_l, 0.236, use_log)
                        float sl_lim = show_manip ? calc_fib_short(h_s, cur_l, 2.000, use_log) : calc_fib_short(h_s, cur_l, 0.860, use_log)
                        float tp_target = calc_fib_short(h_s, cur_l, 0.500, use_log)

                        if not entered_0618
                            if high[k] >= in_0618
                                entered_0618 := true
                                entry_k_0618 := k

                        // 1. Проверка взятия тейка:
                        // Если вошли оба ордера: сетка полностью закрыта, только когда закрыт Ордер 1 (TP 0.236 или пик cur_l)
                        // Если вошел только Ордер 1: закрывается на TP 0.236
                        int entry_short_ref = entered_0618 ? entry_k_05 : entry_k_05
                        bool tp_hit = (k < entry_short_ref and (low[k] <= tp_0236 or close[k] <= tp_0236 or low[k] <= cur_l or close[k] <= cur_l)) or
                                      (k == entry_short_ref and (close[k] <= tp_0236 or close[k] <= cur_l))
                        if tp_hit
                            broken := true
                            break
                        
                        if high[k] > h_s
                            if show_manip
                                float manip_1618 = calc_fib_short(h_s, cur_l, 1.618, use_log)
                                if high[k] >= manip_1618 and (low[k] <= tp_target or close[k] <= tp_target)
                                    broken := true
                                    break
                            else
                                broken := true
                                break

                        if high[k] >= sl_lim
                            broken := true
                            break
            
            if is_dump and not broken
                if not entered_05
                    if low[0] < cur_l
                        cur_l := low[0]
                        end_idx := 0
                    float fib_05_live = calc_fib_short(h_s, cur_l, 0.500, use_log)
                    if high[0] >= fib_05_live
                        entered_05 := true
                        entry_k_05 := 0
                else
                    float in_0618 = calc_fib_short(h_s, cur_l, 0.618, use_log)
                    float tp_0382 = calc_fib_short(h_s, cur_l, 0.382, use_log)
                    float tp_0236 = calc_fib_short(h_s, cur_l, 0.236, use_log)
                    if not entered_0618 and high[0] >= in_0618
                        entered_0618 := true
                        entry_k_0618 := 0
                    
                    int entry_live_ref = entered_0618 ? entry_k_05 : entry_k_05
                    bool tp_live_hit = (entry_live_ref > 0 and (low[0] <= tp_0236 or close[0] <= tp_0236 or low[0] <= cur_l or close[0] <= cur_l)) or
                                       (entry_live_ref == 0 and (close[0] <= tp_0236 or close[0] <= cur_l))
                    if tp_live_hit
                        broken := true
                    
                    if not broken
                        float sl_lim = show_manip ? calc_fib_short(h_s, cur_l, 2.000, use_log) : calc_fib_short(h_s, cur_l, 0.860, use_log)
                        if low[0] <= cur_l or close[0] <= cur_l or high[0] >= sl_lim
                            broken := true

            if is_dump and not broken
                float pct = (h_s - cur_l) / h_s * 100.0
                if pct >= min_pct
                    if pct > best_pct
                        best_pct   := pct
                        best_start := bar_index - s
                        best_high  := h_s
                        best_low   := cur_l
                        best_bars  := s - end_idx + 1

    [best_start, best_high, best_low, best_pct, best_bars]

// ══════════════════════════════════════════════════════════════════════════════
// 7. ОТРИСОВКА СЕТОК НА ГРАФИКЕ
// ══════════════════════════════════════════════════════════════════════════════
var line[] lines_arr   = array.new_line()
var label[] labels_arr = array.new_label()
var table risk_tbl     = table.new(position.top_right, 2, 22, bgcolor=color.new(#0b0e14, 15), border_color=color.new(#1e293b, 0), border_width=1)

// Индикатор MACD и RSI
[macd_line, signal_line, hist_line] = ta.macd(close, i_macd_fast, i_macd_slow, i_macd_sig)
rsi_val = ta.rsi(close, 14)
bool is_macd_bull = macd_line > signal_line
bool is_macd_bear = macd_line < signal_line

if barstate.islast
    for ln in lines_arr
        line.delete(ln)
    lines_arr.clear()
    for lb in labels_arr
        label.delete(lb)
    labels_arr.clear()

    // Старшая Фиба: Свинг-поиск макро-волн
    // Младшая Фиба: Локальные импульсы только с подтвержденным завершением (b >= 1)
    [maj_l_s, maj_l_low, maj_l_high, maj_l_pct] = find_macro_long(maj_lookb, maj_min_p)
    [min_l_s, min_l_low, min_l_high, min_l_pct, min_l_bars] = find_minor_long(min_lookb, min_min_p, min_bars)

    [maj_s_s, maj_s_high, maj_s_low, maj_s_pct] = find_macro_short(maj_lookb, maj_min_p)
    [min_s_s, min_s_high, min_s_low, min_s_pct, min_s_bars] = find_minor_short(min_lookb, min_min_p, min_bars)

    bool allow_long  = (i_mode == "Только LONG") or (i_mode == "Оба направления (L+S)") or (i_mode == "Авто (по тренду)" and (na(min_s_pct) or min_l_pct >= min_s_pct))
    bool allow_short = (i_mode == "Только SHORT") or (i_mode == "Оба направления (L+S)") or (i_mode == "Авто (по тренду)" and (na(min_l_pct) or min_s_pct > min_l_pct))

    int x_end = bar_index + 16

    bool  swp_detected_long  = false
    bool  swp_detected_short = false
    float swp_pct_val        = 0.0
    float swp_ext_val        = 0.0
    float swp_target_val     = 0.0

    // ── 1. LONG СЕТКИ ──
    if allow_long
        // 🏛️ Старшая Long (Точно 80.88 -> 84.08 с манипуляцией 1.618)
        if show_maj and not na(maj_l_high) and not na(maj_l_low)
            float h = maj_l_high, float l = maj_l_low, int x_start = maj_l_s
            string pos = maj_lbl_pos
            
            float p000 = calc_fib_long(h, l, 0.000, use_log)
            draw_level(p000, "🏛️ TOP " + fmt_p(p000), col_maj_000, w_maj_000, "dashed", x_start, x_end, pos, lines_arr, labels_arr)
            
            if show_0236
                float p023 = calc_fib_long(h, l, 0.236, use_log)
                draw_level(p023, "🎯 TP-2 (0.236) " + fmt_p(p023), col_maj_023, w_maj_023, "dotted", x_start, x_end, pos, lines_arr, labels_arr)
            if show_0382
                float p038 = calc_fib_long(h, l, 0.382, use_log)
                draw_level(p038, "🎯 TP (0.382) " + fmt_p(p038), col_maj_038, w_maj_038, "solid", x_start, x_end, pos, lines_arr, labels_arr)
            
            float p050 = calc_fib_long(h, l, 0.500, use_log)
            draw_level(p050, "⬆️ 0.500  " + fmt_p(p050), col_maj_050, w_maj_050, "solid", x_start, x_end, pos, lines_arr, labels_arr)
            
            float p061 = calc_fib_long(h, l, 0.618, use_log)
            draw_level(p061, "⬆️ 0.618  " + fmt_p(p061), col_maj_061, w_maj_061, "solid", x_start, x_end, pos, lines_arr, labels_arr)
            
            if show_0786
                float p078 = calc_fib_long(h, l, 0.786, use_log)
                draw_level(p078, "⬆️ 0.786  " + fmt_p(p078), col_maj_078, w_maj_078, "dotted", x_start, x_end, pos, lines_arr, labels_arr)
            if show_0860
                float p086 = calc_fib_long(h, l, 0.860, use_log)
                draw_level(p086, "🛑 SL (0.860) " + fmt_p(p086), col_maj_086, w_maj_086, "dashed", x_start, x_end, pos, lines_arr, labels_arr)
            
            float p100 = calc_fib_long(h, l, 1.000, use_log)
            draw_level(p100, "🛑 LOW (1.0) " + fmt_p(p100), col_maj_100, w_maj_100, "solid", x_start, x_end, pos, lines_arr, labels_arr)
            
            if show_manip
                float p141 = calc_fib_long(h, l, 1.414, use_log)
                float p161 = calc_fib_long(h, l, 1.618, use_log)
                float p200 = calc_fib_long(h, l, 2.000, use_log)
                draw_level(p141, "🔴 1.414  " + fmt_p(p141), col_maj_141, w_maj_141, "solid", x_start, x_end, pos, lines_arr, labels_arr)
                draw_level(p161, "🟣 1.618  " + fmt_p(p161), col_maj_161, w_maj_161, "solid", x_start, x_end, pos, lines_arr, labels_arr)
                draw_level(p200, "🟠 2.000  " + fmt_p(p200), col_maj_200, w_maj_200, "solid", x_start, x_end, pos, lines_arr, labels_arr)

        // ⚡ Младшая Long (Динамически растет от 80.15 к текущему пику)
        if show_min and not na(min_l_high) and not na(min_l_low)
            float h = min_l_high, float l = min_l_low, int x_start = min_l_s
            
            if show_0236
                float p023 = calc_fib_long(h, l, 0.236, use_log)
                draw_level(p023, "🎯 TP-2 (0.236) " + fmt_p(p023), col_min_023, w_min_023, "dotted", x_start, x_end, "Справа", lines_arr, labels_arr)
            if show_0382
                float p038 = calc_fib_long(h, l, 0.382, use_log)
                draw_level(p038, "🎯 TP (0.382) " + fmt_p(p038), col_min_038, w_min_038, "dotted", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            float p050 = calc_fib_long(h, l, 0.500, use_log)
            draw_level(p050, "⬆️ 0.500  " + fmt_p(p050), col_min_050, w_min_050, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            float p061 = calc_fib_long(h, l, 0.618, use_log)
            draw_level(p061, "⬆️ 0.618  " + fmt_p(p061), col_min_061, w_min_061, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            if show_0786
                float p078 = calc_fib_long(h, l, 0.786, use_log)
                draw_level(p078, "⬆️ 0.786  " + fmt_p(p078), col_min_078, w_min_078, "dotted", x_start, x_end, "Справа", lines_arr, labels_arr)
            if show_0860
                float p086 = calc_fib_long(h, l, 0.860, use_log)
                draw_level(p086, "🛑 SL (0.860) " + fmt_p(p086), col_min_086, w_min_086, "dashed", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            float p100 = calc_fib_long(h, l, 1.000, use_log)
            draw_level(p100, "🛑 LOW (1.0) " + fmt_p(p100), col_min_100, w_min_100, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            if show_manip
                float p141 = calc_fib_long(h, l, 1.414, use_log)
                float p161 = calc_fib_long(h, l, 1.618, use_log)
                float p200 = calc_fib_long(h, l, 2.000, use_log)
                draw_level(p141, "🔴 1.414  " + fmt_p(p141), col_min_141, w_min_141, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
                draw_level(p161, "🟣 1.618  " + fmt_p(p161), col_min_161, w_min_161, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
                draw_level(p200, "🟠 2.000  " + fmt_p(p200), col_min_200, w_min_200, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)

            // 🎯 Детектор Ложного Пробоя (Sweep Reclaim & Бычья Дивергенция MACD)
            if show_swp
                int bars_since_start = math.min(bar_index - x_start, 250)
                if bars_since_start > 0
                    float sweep_low = 1e10
                    int   sweep_k   = -1
                    for k = bars_since_start - 1 to 0
                        if low[k] < sweep_low
                            sweep_low := low[k]
                            sweep_k   := k
                    
                    if sweep_low < l
                        float swp_pct = (l - sweep_low) / l * 100.0
                        if swp_pct <= max_swp_p
                            // Проверяем возврат (Reclaim) выше 1.000
                            bool has_reclaim = false
                            int  reclaim_k   = -1
                            for k = sweep_k to 0
                                if close[k] >= l or (close[k] > open[k] and (close[k] - low[k]) > (high[k] - close[k]))
                                    has_reclaim := true
                                    reclaim_k   := k
                                    break
                            
                            // Проверяем моментум / дивергенцию MACD
                            int prev_k = math.min(sweep_k + 1, 200)
                            bool macd_rebound = (hist_line[sweep_k] > hist_line[prev_k]) or (hist_line[0] > hist_line[sweep_k]) or (hist_line[0] > 0)
                            
                            if has_reclaim and macd_rebound
                                swp_detected_long := true
                                swp_pct_val       := swp_pct
                                swp_ext_val       := sweep_low
                                swp_target_val    := calc_fib_long(h, l, 0.500, use_log)
                                
                                int swp_bar_idx = bar_index - sweep_k
                                int rec_bar_idx = bar_index - (reclaim_k >= 0 ? reclaim_k : 0)
                                
                                // 1. Метка Ложного Пробоя на графике
                                label lb_swp = label.new(x=rec_bar_idx, y=sweep_low,
                                    text="🎯 ЛОЖНЫЙ ПРОБОЙ (СВИП)\n" +
                                         "Бычья дивергенция MACD\n" +
                                         "Свип: -" + str.tostring(swp_pct, "#.##") + "% (" + fmt_p(sweep_low) + ")\n" +
                                         "Вход: Reclaim " + fmt_p(l) + "\n" +
                                         "🎯 Цель (0.500): " + fmt_p(swp_target_val) + "\n" +
                                         "🛑 Стоп: " + fmt_p(sweep_low),
                                    color=color.new(#10b981, 0), textcolor=color.white,
                                    style=label.style_label_up, size=size.normal)
                                array.push(labels_arr, lb_swp)
                                
                                // 2. Линия стопа свипа
                                line ln_swp = line.new(x1=swp_bar_idx, y1=sweep_low, x2=x_end, y2=sweep_low,
                                    color=#06b6d4, width=2, style=line.style_dashed)
                                array.push(lines_arr, ln_swp)
                                label lb_swp_sl = label.new(x=x_end, y=sweep_low, text="🛑 СТОП СВИПА " + fmt_p(sweep_low),
                                    color=color.new(color.black, 100), textcolor=#06b6d4, style=label.style_label_left, size=size.small)
                                array.push(labels_arr, lb_swp_sl)
                                
                                // 3. Стрелка к цели 0.500
                                line ln_target = line.new(x1=rec_bar_idx, y1=l, x2=x_end, y2=swp_target_val,
                                    color=color.new(#10b981, 30), width=2, style=line.style_arrow_right)
                                array.push(lines_arr, ln_target)

    // ── 2. SHORT СЕТКИ ──
    if allow_short
        // 🏛️ Старшая Short
        if show_maj and not na(maj_s_high) and not na(maj_s_low)
            float h = maj_s_high, float l = maj_s_low, int x_start = maj_s_s
            string pos = maj_lbl_pos
            
            float p000 = calc_fib_short(h, l, 0.000, use_log)
            draw_level(p000, "🏛️ BOT " + fmt_p(p000), col_maj_000, w_maj_000, "dashed", x_start, x_end, pos, lines_arr, labels_arr)
            
            if show_0236
                float p023 = calc_fib_short(h, l, 0.236, use_log)
                draw_level(p023, "🎯 TP-2 (0.236) " + fmt_p(p023), col_maj_023, w_maj_023, "dotted", x_start, x_end, pos, lines_arr, labels_arr)
            if show_0382
                float p038 = calc_fib_short(h, l, 0.382, use_log)
                draw_level(p038, "🎯 TP (0.382) " + fmt_p(p038), col_maj_038, w_maj_038, "solid", x_start, x_end, pos, lines_arr, labels_arr)
            
            float p050 = calc_fib_short(h, l, 0.500, use_log)
            draw_level(p050, "⬇️ 0.500  " + fmt_p(p050), col_maj_050, w_maj_050, "solid", x_start, x_end, pos, lines_arr, labels_arr)
            
            float p061 = calc_fib_short(h, l, 0.618, use_log)
            draw_level(p061, "⬇️ 0.618  " + fmt_p(p061), col_maj_061, w_maj_061, "solid", x_start, x_end, pos, lines_arr, labels_arr)
            
            if show_0786
                float p078 = calc_fib_short(h, l, 0.786, use_log)
                draw_level(p078, "⬇️ 0.786  " + fmt_p(p078), col_maj_078, w_maj_078, "dotted", x_start, x_end, pos, lines_arr, labels_arr)
            if show_0860
                float p086 = calc_fib_short(h, l, 0.860, use_log)
                draw_level(p086, "🛑 SL (0.860) " + fmt_p(p086), col_maj_086, w_maj_086, "dashed", x_start, x_end, pos, lines_arr, labels_arr)
            
            float p100 = calc_fib_short(h, l, 1.000, use_log)
            draw_level(p100, "🛑 HIGH (1.0) " + fmt_p(p100), col_maj_100, w_maj_100, "solid", x_start, x_end, pos, lines_arr, labels_arr)
            
            if show_manip
                float p141 = calc_fib_short(h, l, 1.414, use_log)
                float p161 = calc_fib_short(h, l, 1.618, use_log)
                float p200 = calc_fib_short(h, l, 2.000, use_log)
                draw_level(p141, "🔴 1.414  " + fmt_p(p141), col_maj_141, w_maj_141, "solid", x_start, x_end, pos, lines_arr, labels_arr)
                draw_level(p161, "🟣 1.618  " + fmt_p(p161), col_maj_161, w_maj_161, "solid", x_start, x_end, pos, lines_arr, labels_arr)
                draw_level(p200, "🟠 2.000  " + fmt_p(p200), col_maj_200, w_maj_200, "solid", x_start, x_end, pos, lines_arr, labels_arr)

        // ⚡ Младшая Short
        if show_min and not na(min_s_high) and not na(min_s_low)
            float h = min_s_high, float l = min_s_low, int x_start = min_s_s
            
            if show_0236
                float p023 = calc_fib_short(h, l, 0.236, use_log)
                draw_level(p023, "🎯 TP-2 (0.236) " + fmt_p(p023), col_min_023, w_min_023, "dotted", x_start, x_end, "Справа", lines_arr, labels_arr)
            if show_0382
                float p038 = calc_fib_short(h, l, 0.382, use_log)
                draw_level(p038, "🎯 TP (0.382) " + fmt_p(p038), col_min_038, w_min_038, "dotted", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            float p050 = calc_fib_short(h, l, 0.500, use_log)
            draw_level(p050, "⬇️ 0.500  " + fmt_p(p050), col_min_050, w_min_050, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            float p061 = calc_fib_short(h, l, 0.618, use_log)
            draw_level(p061, "⬇️ 0.618  " + fmt_p(p061), col_min_061, w_min_061, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            if show_0786
                float p078 = calc_fib_short(h, l, 0.786, use_log)
                draw_level(p078, "⬇️ 0.786  " + fmt_p(p078), col_min_078, w_min_078, "dotted", x_start, x_end, "Справа", lines_arr, labels_arr)
            if show_0860
                float p086 = calc_fib_short(h, l, 0.860, use_log)
                draw_level(p086, "🛑 SL (0.860) " + fmt_p(p086), col_min_086, w_min_086, "dashed", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            float p100 = calc_fib_short(h, l, 1.000, use_log)
            draw_level(p100, "🛑 HIGH (1.0) " + fmt_p(p100), col_min_100, w_min_100, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            if show_manip
                float p141 = calc_fib_short(h, l, 1.414, use_log)
                float p161 = calc_fib_short(h, l, 1.618, use_log)
                float p200 = calc_fib_short(h, l, 2.000, use_log)
                draw_level(p141, "🔴 1.414  " + fmt_p(p141), col_min_141, w_min_141, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
                draw_level(p161, "🟣 1.618  " + fmt_p(p161), col_min_161, w_min_161, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
                draw_level(p200, "🟠 2.000  " + fmt_p(p200), col_min_200, w_min_200, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)

            // 🎯 Детектор Ложного Выноса вверх (Sweep Reclaim & Медвежья Дивергенция MACD в Short)
            if show_swp
                int bars_since_start = math.min(bar_index - x_start, 250)
                if bars_since_start > 0
                    float sweep_high = -1e10
                    int   sweep_k    = -1
                    for k = bars_since_start - 1 to 0
                        if high[k] > sweep_high
                            sweep_high := high[k]
                            sweep_k    := k
                    
                    if sweep_high > h
                        float swp_pct = (sweep_high - h) / h * 100.0
                        if swp_pct <= max_swp_p
                            bool has_reclaim = false
                            int  reclaim_k   = -1
                            for k = sweep_k to 0
                                if close[k] <= h or (close[k] < open[k] and (high[k] - close[k]) > (close[k] - low[k]))
                                    has_reclaim := true
                                    reclaim_k   := k
                                    break
                            
                            int prev_k = math.min(sweep_k + 1, 200)
                            bool macd_rebound = (hist_line[sweep_k] < hist_line[prev_k]) or (hist_line[0] < hist_line[sweep_k]) or (hist_line[0] < 0)
                            
                            if has_reclaim and macd_rebound
                                swp_detected_short := true
                                swp_pct_val        := swp_pct
                                swp_ext_val        := sweep_high
                                swp_target_val     := calc_fib_short(h, l, 0.500, use_log)
                                
                                int swp_bar_idx = bar_index - sweep_k
                                int rec_bar_idx = bar_index - (reclaim_k >= 0 ? reclaim_k : 0)
                                
                                label lb_swp = label.new(x=rec_bar_idx, y=sweep_high,
                                    text="🎯 ЛОЖНЫЙ ВЫНОС (СВИП)\n" +
                                         "Медвежья дивергенция MACD\n" +
                                         "Свип: +" + str.tostring(swp_pct, "#.##") + "% (" + fmt_p(sweep_high) + ")\n" +
                                         "Вход: Reclaim " + fmt_p(h) + "\n" +
                                         "🎯 Цель (0.500): " + fmt_p(swp_target_val) + "\n" +
                                         "🛑 Стоп: " + fmt_p(sweep_high),
                                    color=color.new(#ef4444, 0), textcolor=color.white,
                                    style=label.style_label_down, size=size.normal)
                                array.push(labels_arr, lb_swp)
                                
                                line ln_swp = line.new(x1=swp_bar_idx, y1=sweep_high, x2=x_end, y2=sweep_high,
                                    color=#fb923c, width=2, style=line.style_dashed)
                                array.push(lines_arr, ln_swp)
                                label lb_swp_sl = label.new(x=x_end, y=sweep_high, text="🛑 СТОП СВИПА " + fmt_p(sweep_high),
                                    color=color.new(color.black, 100), textcolor=#fb923c, style=label.style_label_left, size=size.small)
                                array.push(labels_arr, lb_swp_sl)
                                
                                line ln_target = line.new(x1=rec_bar_idx, y1=h, x2=x_end, y2=swp_target_val,
                                    color=color.new(#ef4444, 30), width=2, style=line.style_arrow_right)
                                array.push(lines_arr, ln_target)

    // ── 3. ПАНЕЛЬ ОЦЕНКИ РИСКА И КАЛЬКУЛЯТОР ПОЗИЦИИ ──
    if show_table
        // Заголовок
        table.cell(risk_tbl, 0, 0, "⚡ ФИЛЬТР MACD & СИГНАЛ", bgcolor=color.new(#1e293b, 20), text_color=color.white, text_size=size.small)
        table.cell(risk_tbl, 1, 0, "СТАТУС И ВЕРОЯТНОСТЬ", bgcolor=color.new(#1e293b, 20), text_color=color.white, text_size=size.small)

        // 1. Проверка качества импульса
        float cur_imp_pct  = allow_long ? min_l_pct : min_s_pct
        int   cur_imp_bars = allow_long ? min_l_bars : min_s_bars
        bool  has_impulse  = not na(cur_imp_pct) and not na(cur_imp_bars)
        bool  is_mature    = has_impulse and cur_imp_bars >= i_safe_bars
        bool  is_strong    = has_impulse and cur_imp_pct >= i_safe_pct
        bool  is_safe_imp  = is_mature and is_strong

        string imp_title  = "Импульс (" + (has_impulse ? str.tostring(cur_imp_pct, "#.#") + "%, " + str.tostring(cur_imp_bars) + " св." : "—") + "):"
        string imp_status = is_safe_imp ? "💎 ПОДТВЕРЖДЕН (≥" + str.tostring(i_safe_pct, "#.#") + "%)" : (not is_mature ? "⚠️ СПАЙК (<" + str.tostring(i_safe_bars) + " св.)" : "⚠️ СЛАБЫЙ (<" + str.tostring(i_safe_pct, "#.#") + "%)")
        color  imp_col    = is_safe_imp ? color.lime : (not is_mature ? color.orange : color.yellow)
        table.cell(risk_tbl, 0, 1, imp_title, text_color=color.silver, text_size=size.small)
        table.cell(risk_tbl, 1, 1, imp_status, text_color=imp_col, text_size=size.small)

        // 2. Статус MACD (Линия против Сигнала)
        bool macd_ok = allow_long ? is_macd_bull : is_macd_bear
        string macd_title  = "MACD (" + str.tostring(i_macd_fast) + "," + str.tostring(i_macd_slow) + "," + str.tostring(i_macd_sig) + "):"
        string macd_status = macd_ok ? (allow_long ? "🟢 БЫЧИЙ (Линия > Сигнал)" : "🔴 МЕДВЕЖИЙ (Линия < Сигнал)") : (allow_long ? "❌ МЕДВЕЖИЙ (Против лонга!)" : "❌ БЫЧИЙ (Против шорта!)")
        color  macd_col    = macd_ok ? color.lime : color.red
        table.cell(risk_tbl, 0, 2, macd_title, text_color=color.silver, text_size=size.small)
        table.cell(risk_tbl, 1, 2, macd_status, text_color=macd_col, text_size=size.small)

        // 3. Гистограмма MACD и Моментум
        bool hist_growing = allow_long ? (hist_line > hist_line[1]) : (hist_line < hist_line[1])
        string hist_title = "Гистограмма MACD:"
        string hist_val_str = (hist_line >= 0 ? "+" : "") + str.tostring(hist_line, "#.####")
        string hist_status = hist_val_str + (hist_growing ? " (Растет ↗)" : " (Затухает ↘)")
        color  hist_col = (allow_long ? hist_line > 0 : hist_line < 0) ? (hist_growing ? color.lime : #a3e635) : color.orange
        table.cell(risk_tbl, 0, 3, hist_title, text_color=color.silver, text_size=size.small)
        table.cell(risk_tbl, 1, 3, hist_status, text_color=hist_col, text_size=size.small)

        // 4. Оценка Модуля Качества Импульса (RSI + Фитиль)
        int peak_bars_ago = 0
        if allow_long and not na(min_l_s) and not na(min_l_bars)
            peak_bars_ago := math.max(0, (bar_index - min_l_s) - min_l_bars + 1)
        else if allow_short and not na(min_s_s) and not na(min_s_bars)
            peak_bars_ago := math.max(0, (bar_index - min_s_s) - min_s_bars + 1)

        float p_high  = high[peak_bars_ago]
        float p_low   = low[peak_bars_ago]
        float p_open  = open[peak_bars_ago]
        float p_close = close[peak_bars_ago]
        float p_rng   = p_high - p_low
        float p_wick  = p_rng > 0 ? (allow_long ? (p_high - math.max(p_open, p_close)) / p_rng * 100.0 : (math.min(p_open, p_close) - p_low) / p_rng * 100.0) : 0.0
        float p_rsi   = rsi_val[peak_bars_ago]

        bool qual_rsi_ok  = not use_qual or (p_rsi >= rsi_min and p_rsi <= rsi_max)
        bool qual_wick_ok = not use_qual or (p_wick <= max_wick_p)
        bool qual_ok      = qual_rsi_ok and qual_wick_ok

        string qual_title = "🛡️ МОДУЛЬ КАЧЕСТВА:"
        string qual_status = ""
        color  qual_col    = color.green
        if not use_qual
            qual_status := "⚪ ВЫКЛЮЧЕН (Базовый MACD)"
            qual_col    := color.silver
        else if not qual_wick_ok
            qual_status := "❌ ОПАСНОСТЬ: ФИТИЛЬ " + str.tostring(p_wick, "#.#") + "% (Сброс!)"
            qual_col    := color.red
        else if not qual_rsi_ok
            qual_status := "❌ ОПАСНОСТЬ: RSI " + str.tostring(p_rsi, "#.#") + (p_rsi < rsi_min ? " (Слабость < 50)" : " (Перегрев > 82)")
            qual_col    := color.red
        else
            qual_status := "💎 ОДОБРЕНО (RSI: " + str.tostring(p_rsi, "#.#") + ", Фитиль: " + str.tostring(p_wick, "#.#") + "%)"
            qual_col    := color.lime

        table.cell(risk_tbl, 0, 4, qual_title, bgcolor=color.new(#1e293b, 30), text_color=color.white, text_size=size.small)
        table.cell(risk_tbl, 1, 4, qual_status, bgcolor=color.new(#1e293b, 30), text_color=qual_col, text_size=size.small)

        // 5. Вероятность сделки в % (Win-Rate)
        string prob_verdict = ""
        color  prob_col     = color.green
        if not macd_ok
            prob_verdict := "⚠️ 48% (ПРОТИВ MACD! Риск SL)"
            prob_col     := color.red
        else if use_qual and not qual_ok
            prob_verdict := "⚠️ 42% (ОТКЛОНЕН МОДУЛЕМ КАЧЕСТВА)"
            prob_col     := color.red
        else if is_safe_imp and hist_growing and qual_ok
            prob_verdict := "💎 96% (СУПЕР-ВХОД: Качество + Тренд + Моментум)"
            prob_col     := color.lime
        else if is_safe_imp and qual_ok
            prob_verdict := "🟢 90% (ВЫСОКАЯ: Качество подтверждено)"
            prob_col     := color.green
        else
            prob_verdict := "🔵 78% (УМЕРЕННАЯ: Слабый импульс)"
            prob_col     := color.yellow

        table.cell(risk_tbl, 0, 5, "🎯 ВЕРОЯТНОСТЬ СДЕЛКИ:", bgcolor=color.new(#1e293b, 40), text_color=color.white, text_size=size.small)
        table.cell(risk_tbl, 1, 5, prob_verdict, bgcolor=color.new(#1e293b, 40), text_color=prob_col, text_size=size.small)

        if swp_detected_long
            table.cell(risk_tbl, 0, 6, "🎯 СВИП ЛИКВИДНОСТИ:", bgcolor=color.new(#10b981, 20), text_color=color.white, text_size=size.small)
            table.cell(risk_tbl, 1, 6, "🟢 ЛОЖНЫЙ ПРОБОЙ (-" + str.tostring(swp_pct_val, "#.#") + "%)", bgcolor=color.new(#10b981, 20), text_color=color.lime, text_size=size.small)
            table.cell(risk_tbl, 0, 7, "  Reclaim план:", text_color=color.silver, text_size=size.small)
            table.cell(risk_tbl, 1, 7, "TP 0.500 (" + fmt_p(swp_target_val) + ") | SL " + fmt_p(swp_ext_val), text_color=color.yellow, text_size=size.small)
        else if swp_detected_short
            table.cell(risk_tbl, 0, 6, "🎯 СВИП ЛИКВИДНОСТИ:", bgcolor=color.new(#ef4444, 20), text_color=color.white, text_size=size.small)
            table.cell(risk_tbl, 1, 6, "🔴 ЛОЖНЫЙ ВЫНОС (+" + str.tostring(swp_pct_val, "#.#") + "%)", bgcolor=color.new(#ef4444, 20), text_color=color.orange, text_size=size.small)
            table.cell(risk_tbl, 0, 7, "  Reclaim план:", text_color=color.silver, text_size=size.small)
            table.cell(risk_tbl, 1, 7, "TP 0.500 (" + fmt_p(swp_target_val) + ") | SL " + fmt_p(swp_ext_val), text_color=color.yellow, text_size=size.small)

    // ── 💰 РИСК-КАЛЬКУЛЯТОР ОБЪЕМА ПОЗИЦИИ ──
    bool has_active_long = allow_long and not na(min_l_high) and not na(min_l_low)
    bool has_active_short = allow_short and not na(min_s_high) and not na(min_s_low)

    int cur_row = (swp_detected_long or swp_detected_short) ? 8 : 6

    if has_active_long or has_active_short
        string sl_mode_str = i_sl_mode

        if has_active_long
            float h = min_l_high, float l = min_l_low
            float e500 = calc_fib_long(h, l, 0.500, use_log)
            float e618 = calc_fib_long(h, l, 0.618, use_log)
            float tp236 = calc_fib_long(h, l, 0.236, use_log)
            float tp382 = calc_fib_long(h, l, 0.382, use_log)
            float sl_p = (i_sl_mode == "0.860 Fib") ? calc_fib_long(h, l, 0.860, use_log) : calc_fib_long(h, l, 1.000, use_log)

            // Разделитель с ценой стопа
            table.cell(risk_tbl, 0, cur_row, "💰 ДЛЯ BYBIT (Стоп $" + str.tostring(i_risk_usd, "#.##") + "):", bgcolor=color.new(#1e293b, 30), text_color=color.yellow, text_size=size.small)
            table.cell(risk_tbl, 1, cur_row, "🛑 Стоп (" + sl_mode_str + "): " + fmt_p(sl_p), bgcolor=color.new(#1e293b, 30), text_color=color.red, text_size=size.small)
            cur_row := cur_row + 1

            if show_calc_500
                float loss_per_coin = (e500 - sl_p) + (e500 * fee_maker) + (sl_p * fee_taker)
                float qty500  = loss_per_coin > 0 ? (i_risk_usd / loss_per_coin) : 0.0
                float notional500 = qty500 * e500
                float gain_per_coin = (tp236 - e500) - (e500 * fee_maker) - (tp236 * fee_maker)
                float pnl500 = qty500 * gain_per_coin
                float roi500 = math.abs(tp236 - e500) / e500 * 100.0
                table.cell(risk_tbl, 0, cur_row, "🟢 Long 0.500: " + fmt_p(e500), text_color=#f59e0b, text_size=size.small)
                table.cell(risk_tbl, 1, cur_row, str.tostring(qty500, "#.##") + " шт. ($" + str.tostring(notional500, "#.#") + ")", text_color=color.white, text_size=size.small)
                cur_row := cur_row + 1
                table.cell(risk_tbl, 0, cur_row, "  🎯 Тейк 0.236: " + fmt_p(tp236), text_color=color.silver, text_size=size.small)
                table.cell(risk_tbl, 1, cur_row, "+$" + str.tostring(pnl500, "#.##") + " (ROI +" + str.tostring(roi500, "#.##") + "%)", text_color=color.lime, text_size=size.small)
                cur_row := cur_row + 1

            if show_calc_618
                float loss_per_coin = (e618 - sl_p) + (e618 * fee_maker) + (sl_p * fee_taker)
                float qty618  = loss_per_coin > 0 ? (i_risk_usd / loss_per_coin) : 0.0
                float notional618 = qty618 * e618
                float gain_per_coin = (tp382 - e618) - (e618 * fee_maker) - (tp382 * fee_maker)
                float pnl618 = qty618 * gain_per_coin
                float roi618 = math.abs(tp382 - e618) / e618 * 100.0
                table.cell(risk_tbl, 0, cur_row, "🟢 Long 0.618: " + fmt_p(e618), text_color=color.yellow, text_size=size.small)
                table.cell(risk_tbl, 1, cur_row, str.tostring(qty618, "#.##") + " шт. ($" + str.tostring(notional618, "#.#") + ")", text_color=color.white, text_size=size.small)
                cur_row := cur_row + 1
                table.cell(risk_tbl, 0, cur_row, "  🎯 Тейк 0.382: " + fmt_p(tp382), text_color=color.silver, text_size=size.small)
                table.cell(risk_tbl, 1, cur_row, "+$" + str.tostring(pnl618, "#.##") + " (ROI +" + str.tostring(roi618, "#.##") + "%)", text_color=color.lime, text_size=size.small)
                cur_row := cur_row + 1

        else if has_active_short
            float h = min_s_high, float l = min_s_low
            float e500 = calc_fib_short(h, l, 0.500, use_log)
            float e618 = calc_fib_short(h, l, 0.618, use_log)
            float tp236 = calc_fib_short(h, l, 0.236, use_log)
            float tp382 = calc_fib_short(h, l, 0.382, use_log)
            float sl_p = (i_sl_mode == "0.860 Fib") ? calc_fib_short(h, l, 0.860, use_log) : calc_fib_short(h, l, 1.000, use_log)

            // Разделитель с ценой стопа
            table.cell(risk_tbl, 0, cur_row, "💰 ДЛЯ BYBIT (Стоп $" + str.tostring(i_risk_usd, "#.##") + "):", bgcolor=color.new(#1e293b, 30), text_color=color.yellow, text_size=size.small)
            table.cell(risk_tbl, 1, cur_row, "🛑 Стоп (" + sl_mode_str + "): " + fmt_p(sl_p), bgcolor=color.new(#1e293b, 30), text_color=color.red, text_size=size.small)
            cur_row := cur_row + 1

            if show_calc_500
                float loss_per_coin = (sl_p - e500) + (e500 * fee_maker) + (sl_p * fee_taker)
                float qty500  = loss_per_coin > 0 ? (i_risk_usd / loss_per_coin) : 0.0
                float notional500 = qty500 * e500
                float gain_per_coin = (e500 - tp236) - (e500 * fee_maker) - (tp236 * fee_maker)
                float pnl500 = qty500 * gain_per_coin
                float roi500 = math.abs(e500 - tp236) / e500 * 100.0
                table.cell(risk_tbl, 0, cur_row, "🔴 Short 0.500: " + fmt_p(e500), text_color=#f59e0b, text_size=size.small)
                table.cell(risk_tbl, 1, cur_row, str.tostring(qty500, "#.##") + " шт. ($" + str.tostring(notional500, "#.#") + ")", text_color=color.white, text_size=size.small)
                cur_row := cur_row + 1
                table.cell(risk_tbl, 0, cur_row, "  🎯 Тейк 0.236: " + fmt_p(tp236), text_color=color.silver, text_size=size.small)
                table.cell(risk_tbl, 1, cur_row, "+$" + str.tostring(pnl500, "#.##") + " (ROI +" + str.tostring(roi500, "#.##") + "%)", text_color=color.lime, text_size=size.small)
                cur_row := cur_row + 1

            if show_calc_618
                float loss_per_coin = (sl_p - e618) + (e618 * fee_maker) + (sl_p * fee_taker)
                float qty618  = loss_per_coin > 0 ? (i_risk_usd / loss_per_coin) : 0.0
                float notional618 = qty618 * e618
                float gain_per_coin = (e618 - tp382) - (e618 * fee_maker) - (tp382 * fee_maker)
                float pnl618 = qty618 * gain_per_coin
                float roi618 = math.abs(e618 - tp382) / e618 * 100.0
                table.cell(risk_tbl, 0, cur_row, "🔴 Short 0.618: " + fmt_p(e618), text_color=color.yellow, text_size=size.small)
                table.cell(risk_tbl, 1, cur_row, str.tostring(qty618, "#.##") + " шт. ($" + str.tostring(notional618, "#.#") + ")", text_color=color.white, text_size=size.small)
                cur_row := cur_row + 1
                table.cell(risk_tbl, 0, cur_row, "  🎯 Тейк 0.382: " + fmt_p(tp382), text_color=color.silver, text_size=size.small)
                table.cell(risk_tbl, 1, cur_row, "+$" + str.tostring(pnl618, "#.##") + " (ROI +" + str.tostring(roi618, "#.##") + "%)", text_color=color.lime, text_size=size.small)
                cur_row := cur_row + 1
    else
        table.cell(risk_tbl, 0, cur_row, "💰 РАСЧЕТ ОБЪЕМА:", bgcolor=color.new(#1e293b, 30), text_color=color.silver, text_size=size.small)
        table.cell(risk_tbl, 1, cur_row, "Ожидание активной фибы", bgcolor=color.new(#1e293b, 30), text_color=color.gray, text_size=size.small)
