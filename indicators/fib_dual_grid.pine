w_min_078   = input.int(1, "Толщина 0.786", minval=1, maxval=4, group=grp_min_col)

col_min_086 = input.color(color.red, "0.860 (Стоп)", group=grp_min_col)
w_min_086   = input.int(1, "Толщина 0.860", minval=1, maxval=4, group=grp_min_col)

col_min_100 = input.color(color.maroon, "1.000 (Дно)", group=grp_min_col)
w_min_100   = input.int(1, "Толщина 1.000", minval=1, maxval=4, group=grp_min_col)

col_min_141 = input.color(#f43f5e, "1.414 (Манипуляция 1)", group=grp_min_col)
w_min_141   = input.int(1, "Толщина 1.414", minval=1, maxval=4, group=grp_min_col)

col_min_161 = input.color(#e879f9, "1.618 (Манипуляция 2)", group=grp_min_col)
w_min_161   = input.int(2, "Толщина 1.618", minval=1, maxval=4, group=grp_min_col)

col_min_200 = input.color(#fb923c, "2.000 (Добор DCA)", group=grp_min_col)
