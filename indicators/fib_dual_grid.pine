// ══════════════════════════════════════════════════════════════════════════════
// 5. МАТЕМАТИЧЕСКИЕ ФУНКЦИИ И ОТРИСОВКА
// ══════════════════════════════════════════════════════════════════════════════
calc_fib_long(float h, float l, float lvl, bool is_log) =>
    if is_log and h > 0 and l > 0
        math.exp(math.log(h) - lvl * (math.log(h) - math.log(l)))
    else
        h - lvl * (h - l)

calc_fib_short(float h, float l, float lvl, bool is_log) =>
    if is_log and h > 0 and l > 0
        math.exp(math.log(l) + lvl * (math.log(h) - math.log(l)))
    else
        l + lvl * (h - l)

draw_level(float price, string label_text, color col, int width, string style_type, int x_start, int x_end, string label_align, line[] lines_arr, label[] labels_arr) =>
    var line_style = line.style_solid
    if style_type == "dashed"
        line_style := line.style_dashed
    else if style_type == "dotted"
        line_style := line.style_dotted

    line ln = line.new(x_start, price, x_end, price, xloc=xloc.bar_index, color=col, width=width, style=line_style)
    array.push(lines_arr, ln)
    
    int lx = label_align == "Слева" ? x_start : x_end
    var l_style = label_align == "Слева" ? label.style_label_right : label.style_label_left
    
    label lb = label.new(lx, price, label_text, xloc=xloc.bar_index, style=l_style, color=color.new(color.black, 100), textcolor=col, size=size.small)
    array.push(labels_arr, lb)

// ══════════════════════════════════════════════════════════════════════════════
// 6. НАДЕЖНЫЙ ПОИСК АКТИВНЫХ ИМПУЛЬСОВ (МАКРО-СВИНГ И ЛОКАЛЬНАЯ ФИБА)
// ══════════════════════════════════════════════════════════════════════════════

// Поиск Старшей (Макро) Фибы по структурным свингам
find_macro_long(int lookback, float min_pct) =>
    int   best_start = na
    float best_low   = na
    float best_high  = na
    float best_pct   = 0.0
    int   max_s      = math.min(lookback, bar_index)

    if max_s >= 5
        // Сканируем последние вершины
        for b = 1 to math.min(45, max_s - 2)
            float h = high[b]
            // b должна быть сформированной вершиной (не текущая развивающаяся свеча и выше b-1 / b+1)
            if high[b - 1] <= h and high[b + 1] <= h
                // Ищем базу импульса (самый низкий минимум перед взлетом в пределах 32 свечей до старта ралли)
                float cur_min_l = h
                int   cur_min_s = na
                int   scan_end  = math.min(b + 32, max_s)
                for s = b + 1 to scan_end
                    if low[s] < cur_min_l
                        cur_min_l := low[s]
                        cur_min_s := s
                
                if not na(cur_min_s)
                    float pct = (h - cur_min_l) / cur_min_l * 100.0
                    if pct >= min_pct
                        // Проверяем статус после вершины: максимум не должен быть перебит выше
                        bool broken_high = false
                        for p = b - 1 to 0
                            if high[p] > h
                                broken_high := true
                                break
                        if not broken_high
                            if pct > best_pct
                                best_pct   := pct
                                best_start := bar_index - cur_min_s
                                best_low   := cur_min_l
                                best_high  := h

    [best_start, best_low, best_high, best_pct]

find_macro_short(int lookback, float min_pct) =>
    int   best_start = na
    float best_high  = na
    float best_low   = na
    float best_pct   = 0.0
    int   max_s      = math.min(lookback, bar_index)

    if max_s >= 5
        for b = 1 to math.min(45, max_s - 2)
            float l = low[b]
            if low[b - 1] >= l and low[b + 1] >= l
                float cur_max_h = l
                int   cur_max_s = na
                int   scan_end  = math.min(b + 32, max_s)
                for s = b + 1 to scan_end
                    if high[s] > cur_max_h
                        cur_max_h := high[s]
                        cur_max_s := s
                
                if not na(cur_max_s)
                    float pct = (cur_max_h - l) / cur_max_h * 100.0
                    if pct >= min_pct
                        bool broken_low = false
                        for p = b - 1 to 0
                            if low[p] < l
                                broken_low := true
                                break
                        if not broken_low
                            if pct > best_pct
                                best_pct   := pct
                                best_start := bar_index - cur_max_s
                                best_high  := cur_max_h
                                best_low   := l

    [best_start, best_high, best_low, best_pct]

// Поиск Младшей (Локальной) Фибы по строгому правилу:
// 1. Начальная свеча s (low = l_s, high = h_s).
// 2. Импульс подтверждается ТОЛЬКО ЗАКРЫТЫМИ СВЕЧАМИ (до свечи 1 включительно).
// 3. Следующие закрытые свечи НЕ должны опускаться <= 0.500 первой свечи ДО первого закрытого пробоя ее High.
// 4. Пока НЕ БЫЛО входа на 0.500: если цена растет — продолжаем тянуть фибу и ждать откат!
// 5. Если БЫЛ вход на 0.500 (entered = true):
//    - Фибу стираем, когда цена обновляет пик (пробивает уровень 0 / High) или забирает тейк.
//    - Если цена падает ниже уровня 1.0 (Low базы), то при включенной манипуляции ждем прихода к 1.618 и отката до 0.500.
//    - Если пробивается стоп манипуляции (2.000 / 2.618) — фиба удаляется.
find_minor_long(int lookback, float min_pct, int max_duration) =>
    int   best_start = na
    float best_low   = na
    float best_high  = na
    float best_pct   = 0.0
    int   max_s      = math.min(lookback, bar_index)

    if max_s >= 3
        for s = max_s - 1 to 2
            float l_s = low[s]
            float h_s = high[s]
            float cur_h = h_s
            bool  is_impulse   = false
            bool  broken       = false
            bool  entered_05   = false
            bool  entered_0618 = false
            int   end_idx      = s

            // Сканируем только закрытые свечи от s-1 до 1
            for k = s - 1 to 1
                if not is_impulse
                    if low[k] < l_s
                        broken := true
                        break
                    float fib_05_first = calc_fib_long(h_s, l_s, 0.500, use_log)
                    if low[k] <= fib_05_first
                        broken := true
                        break
                    if high[k] > h_s
                        is_impulse := true
                        cur_h := high[k]
                        end_idx := k
                else
                    if not entered_05
                        float fib_05_cur = calc_fib_long(cur_h, l_s, 0.500, use_log)
                        if low[k] <= fib_05_cur
                            // Вход на 0.500 состоялся!
                            entered_05 := true
                        else
                            // Входа на 0.5 еще не было — продолжаем тянуть фибу вслед за новыми максимумами
                            if high[k] > cur_h
                                cur_h := high[k]
                                end_idx := k
                    
                    if entered_05
                        float in_0618 = calc_fib_long(cur_h, l_s, 0.618, use_log)
                        float tp_0382 = calc_fib_long(cur_h, l_s, 0.382, use_log)
                        float sl_lim = show_manip ? calc_fib_long(cur_h, l_s, 2.000, use_log) : calc_fib_long(cur_h, l_s, 0.860, use_log)
                        float tp_target = calc_fib_long(cur_h, l_s, 0.500, use_log)

                        if not entered_0618
                            if low[k] <= in_0618
                                entered_0618 := true

                        // 1. Если был вход на 0.618 и цена взяла Тейк 0.382 (или пробила хай 0) -> сделка отработала, стираем!
                        if entered_0618
                            if high[k] >= tp_0382 or close[k] >= tp_0382 or high[k] >= cur_h or close[k] >= cur_h
                                broken := true
                                break
                        else
                            if high[k] >= cur_h or close[k] >= cur_h
                                broken := true
                                break
                        
                        // 2. Если упали ниже уровня 1.0 (l_s)
                        if low[k] < l_s
                            if show_manip
                                float manip_1618 = calc_fib_long(cur_h, l_s, 1.618, use_log)
                                if low[k] <= manip_1618 and (high[k] >= tp_target or close[k] >= tp_target)
                                    broken := true
                                    break
                            else
                                broken := true
                                break

                        // 3. Выбили предельный стоп
                        if low[k] <= sl_lim
                            broken := true
                            break
            
            // На текущей живой свече [0]:
            if is_impulse and not broken
                if not entered_05
                    if high[0] > cur_h
                        cur_h := high[0]
                    float fib_05_live = calc_fib_long(cur_h, l_s, 0.500, use_log)
                    if low[0] <= fib_05_live
                        entered_05 := true
                else
                    float in_0618 = calc_fib_long(cur_h, l_s, 0.618, use_log)
                    float tp_0382 = calc_fib_long(cur_h, l_s, 0.382, use_log)
                    if not entered_0618 and low[0] <= in_0618
                        entered_0618 := true
                    
                    if entered_0618 and (high[0] >= tp_0382 or close[0] >= tp_0382 or high[0] >= cur_h or close[0] >= cur_h)
                        broken := true
                    else
                        float sl_lim = show_manip ? calc_fib_long(cur_h, l_s, 2.000, use_log) : calc_fib_long(cur_h, l_s, 0.860, use_log)
                        if high[0] >= cur_h or close[0] >= cur_h or low[0] <= sl_lim
                            broken := true

            if is_impulse and not broken
                float pct = (cur_h - l_s) / l_s * 100.0
                if pct >= min_pct
                    if pct > best_pct
                        best_pct   := pct
                        best_start := bar_index - s
                        best_low   := l_s
                        best_high  := cur_h

    [best_start, best_low, best_high, best_pct]

find_minor_short(int lookback, float min_pct, int max_duration) =>
    int   best_start = na
    float best_high  = na
    float best_low   = na
    float best_pct   = 0.0
    int   max_s      = math.min(lookback, bar_index)

    if max_s >= 3
        for s = max_s - 1 to 2
            float h_s = high[s]
            float l_s = low[s]
            float cur_l = l_s
            bool  is_dump     = false
            bool  broken      = false
            bool  entered_05  = false
            bool  entered_0618 = false
            int   end_idx     = s

            for k = s - 1 to 1
                if not is_dump
                    if high[k] > h_s
                        broken := true
                        break
                    float fib_05_first = calc_fib_short(h_s, l_s, 0.500, use_log)
                    if high[k] >= fib_05_first
                        broken := true
                        break
                    if low[k] < l_s
                        is_dump := true
                        cur_l := low[k]
                        end_idx := k
                else
                    if not entered_05
                        float fib_05_cur = calc_fib_short(h_s, cur_l, 0.500, use_log)
                        if high[k] >= fib_05_cur
                            entered_05 := true
                        else
                            if low[k] < cur_l
                                cur_l := low[k]
                                end_idx := k
                    
                    if entered_05
                        float in_0618 = calc_fib_short(h_s, cur_l, 0.618, use_log)
                        float tp_0382 = calc_fib_short(h_s, cur_l, 0.382, use_log)
                        float sl_lim = show_manip ? calc_fib_short(h_s, cur_l, 2.000, use_log) : calc_fib_short(h_s, cur_l, 0.860, use_log)
                        float tp_target = calc_fib_short(h_s, cur_l, 0.500, use_log)

                        if not entered_0618
                            if high[k] >= in_0618
                                entered_0618 := true

                        if entered_0618
                            if low[k] <= tp_0382 or close[k] <= tp_0382 or low[k] <= cur_l or close[k] <= cur_l
                                broken := true
                                break
                        else
                            if low[k] <= cur_l or close[k] <= cur_l
                                broken := true
                                break
                        
                        if high[k] > h_s
                            if show_manip
                                float manip_1618 = calc_fib_short(h_s, cur_l, 1.618, use_log)
                                if high[k] >= manip_1618 and (low[k] <= tp_target or close[k] <= tp_target)
                                    broken := true
                                    break
                            else
                                broken := true
                                break

                        if high[k] >= sl_lim
                            broken := true
                            break
            
            if is_dump and not broken
                if not entered_05
                    if low[0] < cur_l
                        cur_l := low[0]
                    float fib_05_live = calc_fib_short(h_s, cur_l, 0.500, use_log)
                    if high[0] >= fib_05_live
                        entered_05 := true
                else
                    float in_0618 = calc_fib_short(h_s, cur_l, 0.618, use_log)
                    float tp_0382 = calc_fib_short(h_s, cur_l, 0.382, use_log)
                    if not entered_0618 and high[0] >= in_0618
                        entered_0618 := true
                    
                    if entered_0618 and (low[0] <= tp_0382 or close[0] <= tp_0382 or low[0] <= cur_l or close[0] <= cur_l)
                        broken := true
                    else
                        float sl_lim = show_manip ? calc_fib_short(h_s, cur_l, 2.000, use_log) : calc_fib_short(h_s, cur_l, 0.860, use_log)
                        if low[0] <= cur_l or close[0] <= cur_l or high[0] >= sl_lim
                            broken := true

            if is_dump and not broken
                float pct = (h_s - cur_l) / h_s * 100.0
                if pct >= min_pct
                    if pct > best_pct
                        best_pct   := pct
                        best_start := bar_index - s
                        best_high  := h_s
                        best_low   := cur_l

    [best_start, best_high, best_low, best_pct]

// ══════════════════════════════════════════════════════════════════════════════
// 7. ОТРИСОВКА СЕТОК НА ГРАФИКЕ
// ══════════════════════════════════════════════════════════════════════════════
var line[] lines_arr   = array.new_line()
var label[] labels_arr = array.new_label()
var table risk_tbl     = table.new(position.top_right, 2, 8, bgcolor=color.new(#0b0e14, 15), border_color=color.new(#1e293b, 0), border_width=1)

float cur_rsi = ta.rsi(close, 14)
float cur_cci = ta.cci(hlc3, 14)

if barstate.islast
    for ln in lines_arr
        line.delete(ln)
    lines_arr.clear()
    for lb in labels_arr
        label.delete(lb)
    labels_arr.clear()

    // Старшая Фиба: Свинг-поиск макро-волн
    // Младшая Фиба: Локальные импульсы только с подтвержденным завершением (b >= 1)
    [maj_l_s, maj_l_low, maj_l_high, maj_l_pct] = find_macro_long(maj_lookb, maj_min_p)
    [min_l_s, min_l_low, min_l_high, min_l_pct] = find_minor_long(min_lookb, min_min_p, min_bars)

    [maj_s_s, maj_s_high, maj_s_low, maj_s_pct] = find_macro_short(maj_lookb, maj_min_p)
    [min_s_s, min_s_high, min_s_low, min_s_pct] = find_minor_short(min_lookb, min_min_p, min_bars)

    bool allow_long  = (i_mode == "Только LONG") or (i_mode == "Оба направления (L+S)") or (i_mode == "Авто (по тренду)" and (na(min_s_pct) or min_l_pct >= min_s_pct))
    bool allow_short = (i_mode == "Только SHORT") or (i_mode == "Оба направления (L+S)") or (i_mode == "Авто (по тренду)" and (na(min_l_pct) or min_s_pct > min_l_pct))

    int x_end = bar_index + 16

    // ── 1. LONG СЕТКИ ──
    if allow_long
        // 🏛️ Старшая Long (Точно 80.88 -> 84.08 с манипуляцией 1.618)
        if show_maj and not na(maj_l_high) and not na(maj_l_low)
            float h = maj_l_high, float l = maj_l_low, int x_start = maj_l_s
            string pos = maj_lbl_pos
            
            float p000 = calc_fib_long(h, l, 0.000, use_log)
            draw_level(p000, "🏛️ TOP " + str.tostring(p000, "#.####"), col_maj_000, w_maj_000, "dashed", x_start, x_end, pos, lines_arr, labels_arr)
            
            if show_0236
                float p023 = calc_fib_long(h, l, 0.236, use_log)
                draw_level(p023, "🎯 TP-2 (0.236) " + str.tostring(p023, "#.####"), col_maj_023, w_maj_023, "dotted", x_start, x_end, pos, lines_arr, labels_arr)
            if show_0382
                float p038 = calc_fib_long(h, l, 0.382, use_log)
                draw_level(p038, "🎯 TP (0.382) " + str.tostring(p038, "#.####"), col_maj_038, w_maj_038, "solid", x_start, x_end, pos, lines_arr, labels_arr)
            
            float p050 = calc_fib_long(h, l, 0.500, use_log)
            draw_level(p050, "⬆️ 0.500  " + str.tostring(p050, "#.####"), col_maj_050, w_maj_050, "solid", x_start, x_end, pos, lines_arr, labels_arr)
            
            float p061 = calc_fib_long(h, l, 0.618, use_log)
            draw_level(p061, "⬆️ 0.618  " + str.tostring(p061, "#.####"), col_maj_061, w_maj_061, "solid", x_start, x_end, pos, lines_arr, labels_arr)
            
            if show_0786
                float p078 = calc_fib_long(h, l, 0.786, use_log)
                draw_level(p078, "⬆️ 0.786  " + str.tostring(p078, "#.####"), col_maj_078, w_maj_078, "dotted", x_start, x_end, pos, lines_arr, labels_arr)
            if show_0860
                float p086 = calc_fib_long(h, l, 0.860, use_log)
                draw_level(p086, "🛑 SL (0.860) " + str.tostring(p086, "#.####"), col_maj_086, w_maj_086, "dashed", x_start, x_end, pos, lines_arr, labels_arr)
            
            float p100 = calc_fib_long(h, l, 1.000, use_log)
            draw_level(p100, "🛑 LOW (1.0) " + str.tostring(p100, "#.####"), col_maj_100, w_maj_100, "solid", x_start, x_end, pos, lines_arr, labels_arr)
            
            if show_manip
                float p141 = calc_fib_long(h, l, 1.414, use_log)
                float p161 = calc_fib_long(h, l, 1.618, use_log)
                float p200 = calc_fib_long(h, l, 2.000, use_log)
                draw_level(p141, "🔴 1.414  " + str.tostring(p141, "#.####"), col_maj_141, w_maj_141, "solid", x_start, x_end, pos, lines_arr, labels_arr)
                draw_level(p161, "🟣 1.618  " + str.tostring(p161, "#.####"), col_maj_161, w_maj_161, "solid", x_start, x_end, pos, lines_arr, labels_arr)
                draw_level(p200, "🟠 2.000  " + str.tostring(p200, "#.####"), col_maj_200, w_maj_200, "solid", x_start, x_end, pos, lines_arr, labels_arr)

        // ⚡ Младшая Long (Динамически растет от 80.15 к текущему пику)
        if show_min and not na(min_l_high) and not na(min_l_low)
            float h = min_l_high, float l = min_l_low, int x_start = min_l_s
            
            if show_0382
                float p038 = calc_fib_long(h, l, 0.382, use_log)
                draw_level(p038, "🎯 TP (0.382) " + str.tostring(p038, "#.####"), col_min_038, w_min_038, "dotted", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            float p050 = calc_fib_long(h, l, 0.500, use_log)
            draw_level(p050, "⬆️ 0.500  " + str.tostring(p050, "#.####"), col_min_050, w_min_050, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            float p061 = calc_fib_long(h, l, 0.618, use_log)
            draw_level(p061, "⬆️ 0.618  " + str.tostring(p061, "#.####"), col_min_061, w_min_061, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            if show_0786
                float p078 = calc_fib_long(h, l, 0.786, use_log)
                draw_level(p078, "⬆️ 0.786  " + str.tostring(p078, "#.####"), col_min_078, w_min_078, "dotted", x_start, x_end, "Справа", lines_arr, labels_arr)
            if show_0860
                float p086 = calc_fib_long(h, l, 0.860, use_log)
                draw_level(p086, "🛑 SL (0.860) " + str.tostring(p086, "#.####"), col_min_086, w_min_086, "dashed", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            float p100 = calc_fib_long(h, l, 1.000, use_log)
            draw_level(p100, "🛑 LOW (1.0) " + str.tostring(p100, "#.####"), col_min_100, w_min_100, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            if show_manip
                float p141 = calc_fib_long(h, l, 1.414, use_log)
                float p161 = calc_fib_long(h, l, 1.618, use_log)
                float p200 = calc_fib_long(h, l, 2.000, use_log)
                draw_level(p141, "🔴 1.414  " + str.tostring(p141, "#.####"), col_min_141, w_min_141, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
                draw_level(p161, "🟣 1.618  " + str.tostring(p161, "#.####"), col_min_161, w_min_161, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
                draw_level(p200, "🟠 2.000  " + str.tostring(p200, "#.####"), col_min_200, w_min_200, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)

    // ── 2. SHORT СЕТКИ ──
    if allow_short
        // 🏛️ Старшая Short
        if show_maj and not na(maj_s_high) and not na(maj_s_low)
            float h = maj_s_high, float l = maj_s_low, int x_start = maj_s_s
            string pos = maj_lbl_pos
            
            float p000 = calc_fib_short(h, l, 0.000, use_log)
            draw_level(p000, "🏛️ BOT " + str.tostring(p000, "#.####"), col_maj_000, w_maj_000, "dashed", x_start, x_end, pos, lines_arr, labels_arr)
            
            if show_0236
                float p023 = calc_fib_short(h, l, 0.236, use_log)
                draw_level(p023, "🎯 TP-2 (0.236) " + str.tostring(p023, "#.####"), col_maj_023, w_maj_023, "dotted", x_start, x_end, pos, lines_arr, labels_arr)
            if show_0382
                float p038 = calc_fib_short(h, l, 0.382, use_log)
                draw_level(p038, "🎯 TP (0.382) " + str.tostring(p038, "#.####"), col_maj_038, w_maj_038, "solid", x_start, x_end, pos, lines_arr, labels_arr)
            
            float p050 = calc_fib_short(h, l, 0.500, use_log)
            draw_level(p050, "⬇️ 0.500  " + str.tostring(p050, "#.####"), col_maj_050, w_maj_050, "solid", x_start, x_end, pos, lines_arr, labels_arr)
            
            float p061 = calc_fib_short(h, l, 0.618, use_log)
            draw_level(p061, "⬇️ 0.618  " + str.tostring(p061, "#.####"), col_maj_061, w_maj_061, "solid", x_start, x_end, pos, lines_arr, labels_arr)
            
            if show_0786
                float p078 = calc_fib_short(h, l, 0.786, use_log)
                draw_level(p078, "⬇️ 0.786  " + str.tostring(p078, "#.####"), col_maj_078, w_maj_078, "dotted", x_start, x_end, pos, lines_arr, labels_arr)
            if show_0860
                float p086 = calc_fib_short(h, l, 0.860, use_log)
                draw_level(p086, "🛑 SL (0.860) " + str.tostring(p086, "#.####"), col_maj_086, w_maj_086, "dashed", x_start, x_end, pos, lines_arr, labels_arr)
            
            float p100 = calc_fib_short(h, l, 1.000, use_log)
            draw_level(p100, "🛑 HIGH (1.0) " + str.tostring(p100, "#.####"), col_maj_100, w_maj_100, "solid", x_start, x_end, pos, lines_arr, labels_arr)
            
            if show_manip
                float p141 = calc_fib_short(h, l, 1.414, use_log)
                float p161 = calc_fib_short(h, l, 1.618, use_log)
                float p200 = calc_fib_short(h, l, 2.000, use_log)
                draw_level(p141, "🔴 1.414  " + str.tostring(p141, "#.####"), col_maj_141, w_maj_141, "solid", x_start, x_end, pos, lines_arr, labels_arr)
                draw_level(p161, "🟣 1.618  " + str.tostring(p161, "#.####"), col_maj_161, w_maj_161, "solid", x_start, x_end, pos, lines_arr, labels_arr)
                draw_level(p200, "🟠 2.000  " + str.tostring(p200, "#.####"), col_maj_200, w_maj_200, "solid", x_start, x_end, pos, lines_arr, labels_arr)

        // ⚡ Младшая Short
        if show_min and not na(min_s_high) and not na(min_s_low)
            float h = min_s_high, float l = min_s_low, int x_start = min_s_s
            
            if show_0382
                float p038 = calc_fib_short(h, l, 0.382, use_log)
                draw_level(p038, "🎯 TP (0.382) " + str.tostring(p038, "#.####"), col_min_038, w_min_038, "dotted", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            float p050 = calc_fib_short(h, l, 0.500, use_log)
            draw_level(p050, "⬇️ 0.500  " + str.tostring(p050, "#.####"), col_min_050, w_min_050, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            float p061 = calc_fib_short(h, l, 0.618, use_log)
            draw_level(p061, "⬇️ 0.618  " + str.tostring(p061, "#.####"), col_min_061, w_min_061, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            if show_0786
                float p078 = calc_fib_short(h, l, 0.786, use_log)
                draw_level(p078, "⬇️ 0.786  " + str.tostring(p078, "#.####"), col_min_078, w_min_078, "dotted", x_start, x_end, "Справа", lines_arr, labels_arr)
            if show_0860
                float p086 = calc_fib_short(h, l, 0.860, use_log)
                draw_level(p086, "🛑 SL (0.860) " + str.tostring(p086, "#.####"), col_min_086, w_min_086, "dashed", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            float p100 = calc_fib_short(h, l, 1.000, use_log)
            draw_level(p100, "🛑 HIGH (1.0) " + str.tostring(p100, "#.####"), col_min_100, w_min_100, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            if show_manip
                float p141 = calc_fib_short(h, l, 1.414, use_log)
                float p161 = calc_fib_short(h, l, 1.618, use_log)
                float p200 = calc_fib_short(h, l, 2.000, use_log)
                draw_level(p141, "🔴 1.414  " + str.tostring(p141, "#.####"), col_min_141, w_min_141, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
                draw_level(p161, "🟣 1.618  " + str.tostring(p161, "#.####"), col_min_161, w_min_161, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
                draw_level(p200, "🟠 2.000  " + str.tostring(p200, "#.####"), col_min_200, w_min_200, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)

    // ── 3. ПАНЕЛЬ ОЦЕНКИ РИСКА И КАЛЬКУЛЯТОР ПОЗИЦИИ ──
    if show_table
        // Заголовок
        table.cell(risk_tbl, 0, 0, "⚡ ИНДИКАТОРЫ РИСКА", bgcolor=color.new(#1e293b, 20), text_color=color.white, text_size=size.small)
        table.cell(risk_tbl, 1, 0, "СТАТУС ВХОДА", bgcolor=color.new(#1e293b, 20), text_color=color.white, text_size=size.small)

        // Строка RSI 14
        string rsi_status = cur_rsi < 30 ? "⚠️ Перепродан (<30)" : (cur_rsi > 70 ? "⚠️ Перекуплен (>70)" : "✅ Норма (30-70)")
        color rsi_col = cur_rsi < 30 ? color.orange : (cur_rsi > 70 ? color.red : color.green)
        table.cell(risk_tbl, 0, 1, "RSI (14): " + str.tostring(cur_rsi, "#.#"), text_color=color.silver, text_size=size.small)
        table.cell(risk_tbl, 1, 1, rsi_status, text_color=rsi_col, text_size=size.small)

        // Строка CCI 14
        string cci_status = cur_cci < -100 ? "❌ ОПАСНО (Дамп <-100)" : (cur_cci <= 0 ? "👑 ЗОЛОТОЙ ВХОД (-100..0)" : (cur_cci <= 50 ? "✅ Нейтрально (0..50)" : "🚀 Бычий напор (>50)"))
        color cci_col = cur_cci < -100 ? color.red : (cur_cci <= 0 ? color.lime : (cur_cci <= 50 ? color.teal : color.aqua))
        table.cell(risk_tbl, 0, 2, "CCI (14): " + str.tostring(cur_cci, "#.#"), text_color=color.silver, text_size=size.small)
        table.cell(risk_tbl, 1, 2, cci_status, text_color=cci_col, text_size=size.small)

    // Общий вердикт риска
    string verdict_text = cur_cci < -100 or cur_rsi < 30 ? "🔴 ВЫСОКИЙ РИСК (Ждать откат)" : (cur_cci >= -100 and cur_cci <= 0 ? "🟢 НИЗКИЙ РИСК (Винрейт ~90%)" : "🔵 УМЕРЕННЫЙ РИСК")
    color verdict_col = cur_cci < -100 or cur_rsi < 30 ? color.red : (cur_cci >= -100 and cur_cci <= 0 ? color.green : color.blue)
    table.cell(risk_tbl, 0, 3, "🎯 ОБЩИЙ РИСК:", bgcolor=color.new(#1e293b, 40), text_color=color.white, text_size=size.small)
    table.cell(risk_tbl, 1, 3, verdict_text, bgcolor=color.new(#1e293b, 40), text_color=verdict_col, text_size=size.small)

    // ── 💰 РИСК-КАЛЬКУЛЯТОР ОБЪЕМА ПОЗИЦИИ ──
    bool has_active_long = allow_long and not na(min_l_high) and not na(min_l_low)
    bool has_active_short = allow_short and not na(min_s_high) and not na(min_s_low)

    int cur_row = 4

    if has_active_long or has_active_short
        // Разделитель
        string sl_mode_str = i_sl_mode
        table.cell(risk_tbl, 0, cur_row, "💰 РАСЧЕТ ОБЪЕМА (Стоп $" + str.tostring(i_risk_usd, "#.##") + "):", bgcolor=color.new(#1e293b, 30), text_color=color.yellow, text_size=size.small)
        table.cell(risk_tbl, 1, cur_row, "Стоп: " + sl_mode_str, bgcolor=color.new(#1e293b, 30), text_color=color.silver, text_size=size.small)
        cur_row := cur_row + 1

        if has_active_long
            float h = min_l_high, float l = min_l_low
            float e618 = calc_fib_long(h, l, 0.618, use_log)
            float e786 = calc_fib_long(h, l, 0.786, use_log)
            float sl_p = (i_sl_mode == "0.860 Fib") ? calc_fib_long(h, l, 0.860, use_log) : calc_fib_long(h, l, 1.000, use_log)

            if show_calc_618
                float loss_per_coin = (e618 - sl_p) + (e618 * fee_maker) + (sl_p * fee_taker)
                float qty618  = loss_per_coin > 0 ? (i_risk_usd / loss_per_coin) : 0.0
                float notional618 = qty618 * e618
                table.cell(risk_tbl, 0, cur_row, "🟢 Long 0.618 (" + str.tostring(e618, "#.####") + "):", text_color=color.yellow, text_size=size.small)
                table.cell(risk_tbl, 1, cur_row, str.tostring(qty618, "#.##") + " шт. ($" + str.tostring(notional618, "#.#") + ")", text_color=color.lime, text_size=size.small)
                cur_row := cur_row + 1

            if show_calc_786
                float loss_per_coin = (e786 - sl_p) + (e786 * fee_maker) + (sl_p * fee_taker)
                float qty786  = loss_per_coin > 0 ? (i_risk_usd / loss_per_coin) : 0.0
                float notional786 = qty786 * e786
                table.cell(risk_tbl, 0, cur_row, "🟣 Long 0.786 (" + str.tostring(e786, "#.####") + "):", text_color=#c084fc, text_size=size.small)
                table.cell(risk_tbl, 1, cur_row, str.tostring(qty786, "#.##") + " шт. ($" + str.tostring(notional786, "#.#") + ")", text_color=color.aqua, text_size=size.small)
                cur_row := cur_row + 1

        else if has_active_short
            float h = min_s_high, float l = min_s_low
            float e618 = calc_fib_short(h, l, 0.618, use_log)
            float e786 = calc_fib_short(h, l, 0.786, use_log)
            float sl_p = (i_sl_mode == "0.860 Fib") ? calc_fib_short(h, l, 0.860, use_log) : calc_fib_short(h, l, 1.000, use_log)

            if show_calc_618
                float loss_per_coin = (sl_p - e618) + (e618 * fee_maker) + (sl_p * fee_taker)
                float qty618  = loss_per_coin > 0 ? (i_risk_usd / loss_per_coin) : 0.0
                float notional618 = qty618 * e618
                table.cell(risk_tbl, 0, cur_row, "🔴 Short 0.618 (" + str.tostring(e618, "#.####") + "):", text_color=color.yellow, text_size=size.small)
                table.cell(risk_tbl, 1, cur_row, str.tostring(qty618, "#.##") + " шт. ($" + str.tostring(notional618, "#.#") + ")", text_color=color.lime, text_size=size.small)
                cur_row := cur_row + 1

            if show_calc_786
                float loss_per_coin = (sl_p - e786) + (e786 * fee_maker) + (sl_p * fee_taker)
                float qty786  = loss_per_coin > 0 ? (i_risk_usd / loss_per_coin) : 0.0
                float notional786 = qty786 * e786
                table.cell(risk_tbl, 0, cur_row, "🟣 Short 0.786 (" + str.tostring(e786, "#.####") + "):", text_color=#c084fc, text_size=size.small)
                table.cell(risk_tbl, 1, cur_row, str.tostring(qty786, "#.##") + " шт. ($" + str.tostring(notional786, "#.#") + ")", text_color=color.aqua, text_size=size.small)
                cur_row := cur_row + 1
    else
        table.cell(risk_tbl, 0, cur_row, "💰 РАСЧЕТ ОБЪЕМА:", bgcolor=color.new(#1e293b, 30), text_color=color.silver, text_size=size.small)
        table.cell(risk_tbl, 1, cur_row, "Ожидание активной фибы", bgcolor=color.new(#1e293b, 30), text_color=color.gray, text_size=size.small)
