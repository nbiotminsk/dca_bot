//@version=6
indicator("Fibonacci Dual Grid (LONG & SHORT)", shorttitle="Fib Dual Grid (L/S)", overlay=true, max_lines_count=500, max_labels_count=500)

// ─── 1. Настройки ────────────────────────────────────────────────────────────
grp_gen   = "Общие настройки"
i_mode    = input.string("Авто (по тренду)", "Режим торговли", options=["Авто (по тренду)", "Только LONG", "Только SHORT", "Оба направления (L+S)"], group=grp_gen)
use_log   = input.bool(true, "Логарифмическая шкала (Log Fib)", group=grp_gen)

grp_major = "1. Старшая (Глобальная) Фиба"
show_maj  = input.bool(true, "Показывать Старшую Фибу", group=grp_major)
maj_min_p = input.float(5.0, "Мин. размах Старшей Фибы (%)", minval=2.0, step=0.5, group=grp_major)
maj_lookb = input.int(100, "Глубина поиска Старшей (свечей)", minval=20, maxval=300, group=grp_major)

grp_minor = "2. Младшая (Локальная суб-фиба)"
show_min  = input.bool(true, "Показывать Младшую Фибу", group=grp_minor)
min_min_p = input.float(2.0, "Мин. размах Младшей Фибы (%)", minval=1.0, step=0.5, group=grp_minor)
min_lookb = input.int(36, "Глубина поиска Младшей (свечей)", minval=10, maxval=100, group=grp_minor)

grp_lvls  = "Отображение уровней"
show_0236 = input.bool(true, "Показывать 0.236 Fib (Дальний Тейк)", group=grp_lvls)
show_0382 = input.bool(true, "Показывать 0.382 Fib (Базовый Тейк)", group=grp_lvls)
show_0786 = input.bool(true, "Показывать 0.786 Fib (Глубокий Вход)", group=grp_lvls)
show_0860 = input.bool(true, "Показывать 0.860 Fib (Стоп-Лосс)", group=grp_lvls)
show_manip= input.bool(true, "Показывать 1.618 / 2.0 (Манипуляция)", group=grp_lvls)

// ─── Функции расчета Фибоначчи (LONG & SHORT) ────────────────────────────────
calc_fib_long(float h, float l, float lvl, bool is_log) =>
    if is_log and h > 0 and l > 0
        math.exp(math.log(h) - lvl * (math.log(h) - math.log(l)))
    else
        h - lvl * (h - l)

calc_fib_short(float h, float l, float lvl, bool is_log) =>
    if is_log and h > 0 and l > 0
        math.exp(math.log(l) + lvl * (math.log(h) - math.log(l)))
    else
        l + lvl * (h - l)

// ─── Функция отрисовки уровня ────────────────────────────────────────────────
draw_fib_level(float price, float lvl, string name, string pref, color col, int width, string style_type, int x_start, int x_end, line[] lines_arr, label[] labels_arr) =>
    var line_style = line.style_solid
    if style_type == "dashed"
        line_style := line.style_dashed
    else if style_type == "dotted"
        line_style := line.style_dotted

    line ln = line.new(x_start, price, x_end, price, color=col, width=width, style=line_style)
    array.push(lines_arr, ln)
    string txt = pref + name + " (" + str.tostring(lvl, "#.###") + ") = " + str.tostring(price, "#.###") + " $"
    label lb = label.new(x_end, price, txt, style=label.style_label_left, color=color.new(color.black, 100), textcolor=col, size=size.small)
    array.push(labels_arr, lb)

// ─── Поиск LONG импульса ─────────────────────────────────────────────────────
find_long_impulse(int lookback, float min_pct) =>
    int   best_start = na
    float best_low   = na
    float best_high  = na
    float best_pct   = 0.0

    for s = math.max(0, lookback) to 1
        float l = low[s]
        float h = high[s]
        bool  broken = false
        bool  growth = false

        for k = s - 1 to 0
            float fib05 = calc_fib_long(h, l, 0.500, use_log)
            if low[k] <= fib05 or low[k] < l
                broken := true
                break
            if high[k] > h
                h := high[k]
                growth := true

        if not broken and growth
            float pct = (h - l) / l * 100.0
            if pct >= min_pct and (pct > best_pct or na(best_pct))
                best_pct   := pct
                best_start := bar_index - s
                best_low   := l
                best_high  := h

    [best_start, best_low, best_high, best_pct]

// ─── Поиск SHORT импульса (Дамп) ─────────────────────────────────────────────
find_short_impulse(int lookback, float min_pct) =>
    int   best_start = na
    float best_high  = na
    float best_low   = na
    float best_pct   = 0.0

    for s = math.max(0, lookback) to 1
        float h = high[s]
        float l = low[s]
        bool  broken = false
        bool  drop   = false

        for k = s - 1 to 0
            float fib05 = calc_fib_short(h, l, 0.500, use_log)
            if high[k] >= fib05 or high[k] > h
                broken := true
                break
            if low[k] < l
                l := low[k]
                drop := true

        if not broken and drop
            float pct = (h - l) / h * 100.0
            if pct >= min_pct and (pct > best_pct or na(best_pct))
                best_pct   := pct
                best_start := bar_index - s
                best_high  := h
                best_low   := l

    [best_start, best_high, best_low, best_pct]

// ─── Расчет импульсов ────────────────────────────────────────────────────────
[maj_l_s, maj_l_low, maj_l_high, maj_l_pct] = find_long_impulse(maj_lookb, maj_min_p)
[min_l_s, min_l_low, min_l_high, min_l_pct] = find_long_impulse(min_lookb, min_min_p)

[maj_s_s, maj_s_high, maj_s_low, maj_s_pct] = find_short_impulse(maj_lookb, maj_min_p)
[min_s_s, min_s_high, min_s_low, min_s_pct] = find_short_impulse(min_lookb, min_min_p)

// Определение активных направлений
bool allow_long  = (i_mode == "Только LONG") or (i_mode == "Оба направления (L+S)") or (i_mode == "Авто (по тренду)" and (na(maj_s_pct) or maj_l_pct >= maj_s_pct))
bool allow_short = (i_mode == "Только SHORT") or (i_mode == "Оба направления (L+S)") or (i_mode == "Авто (по тренду)" and (na(maj_l_pct) or maj_s_pct > maj_l_pct))

// ─── Отрисовка ───────────────────────────────────────────────────────────────
var line[] lines_arr   = array.new_line()
var label[] labels_arr = array.new_label()

if barstate.islast
    for ln in lines_arr
        line.delete(ln)
    lines_arr.clear()
    for lb in labels_arr
        label.delete(lb)
    labels_arr.clear()

    int x_end = bar_index + 14

    // ── 1. ОТРИСОВКА LONG СЕТОК ──
    if allow_long
        // Старшая Long
        if show_maj and not na(maj_l_high) and not na(maj_l_low)
            float h = maj_l_high, float l = maj_l_low, int x_start = maj_l_s
            string pref = "🟢 СТАРШИЙ LONG: "
            draw_fib_level(calc_fib_long(h, l, 0.000, use_log), 0.000, "TOP (High)", pref, color.gray, 1, "dashed", x_start, x_end, lines_arr, labels_arr)
            if show_0236
                draw_fib_level(calc_fib_long(h, l, 0.236, use_log), 0.236, "🎯 Тейк-2", pref, color.teal, 1, "dotted", x_start, x_end, lines_arr, labels_arr)
            if show_0382
                draw_fib_level(calc_fib_long(h, l, 0.382, use_log), 0.382, "🎯 Тейк-1", pref, color.green, 2, "solid", x_start, x_end, lines_arr, labels_arr)
            draw_fib_level(calc_fib_long(h, l, 0.500, use_log), 0.500, "🔹 Вход-1", pref, #3b82f6, 2, "solid", x_start, x_end, lines_arr, labels_arr)
            draw_fib_level(calc_fib_long(h, l, 0.618, use_log), 0.618, "🔹 Вход-2", pref, color.blue, 2, "solid", x_start, x_end, lines_arr, labels_arr)
            if show_0786
                draw_fib_level(calc_fib_long(h, l, 0.786, use_log), 0.786, "⚡ Вход-3", pref, color.purple, 1, "dotted", x_start, x_end, lines_arr, labels_arr)
            if show_0860
                draw_fib_level(calc_fib_long(h, l, 0.860, use_log), 0.860, "🛑 Стоп", pref, color.red, 2, "dashed", x_start, x_end, lines_arr, labels_arr)
            draw_fib_level(calc_fib_long(h, l, 1.000, use_log), 1.000, "🛑 Дно Low", pref, color.maroon, 2, "solid", x_start, x_end, lines_arr, labels_arr)
            if show_manip
                draw_fib_level(calc_fib_long(h, l, 1.618, use_log), 1.618, "🟣 Манипуляция", pref, color.fuchsia, 2, "solid", x_start, x_end, lines_arr, labels_arr)
                draw_fib_level(calc_fib_long(h, l, 2.000, use_log), 2.000, "🟠 Добор DCA", pref, color.orange, 2, "solid", x_start, x_end, lines_arr, labels_arr)

        // Младшая Long
        bool is_diff_l = na(maj_l_s) or (min_l_s != maj_l_s) or (math.abs(min_l_low - maj_l_low) > 0.0001)
        if show_min and not na(min_l_high) and not na(min_l_low) and is_diff_l
            float h = min_l_high, float l = min_l_low, int x_start = min_l_s
            string pref = "⚡ МЛАДШИЙ LONG: "
            if show_0382
                draw_fib_level(calc_fib_long(h, l, 0.382, use_log), 0.382, "🎯 Тейк (0.382)", pref, color.lime, 1, "dotted", x_start, x_end, lines_arr, labels_arr)
            draw_fib_level(calc_fib_long(h, l, 0.500, use_log), 0.500, "🔹 Вход (0.500)", pref, #06b6d4, 2, "solid", x_start, x_end, lines_arr, labels_arr)
            draw_fib_level(calc_fib_long(h, l, 0.618, use_log), 0.618, "🔹 Вход (0.618)", pref, color.yellow, 2, "solid", x_start, x_end, lines_arr, labels_arr)
            if show_0860
                draw_fib_level(calc_fib_long(h, l, 0.860, use_log), 0.860, "🛑 Стоп (0.860)", pref, color.red, 1, "dashed", x_start, x_end, lines_arr, labels_arr)
            draw_fib_level(calc_fib_long(h, l, 1.000, use_log), 1.000, "🛑 Дно", pref, color.maroon, 1, "solid", x_start, x_end, lines_arr, labels_arr)

    // ── 2. ОТРИСОВКА SHORT СЕТОК ──
    if allow_short
        // Старшая Short
        if show_maj and not na(maj_s_high) and not na(maj_s_low)
            float h = maj_s_high, float l = maj_s_low, int x_start = maj_s_s
            string pref = "🔴 СТАРШИЙ SHORT: "
            draw_fib_level(calc_fib_short(h, l, 0.000, use_log), 0.000, "BOTTOM (Low)", pref, color.gray, 1, "dashed", x_start, x_end, lines_arr, labels_arr)
            if show_0236
                draw_fib_level(calc_fib_short(h, l, 0.236, use_log), 0.236, "🎯 Тейк-2", pref, color.teal, 1, "dotted", x_start, x_end, lines_arr, labels_arr)
            if show_0382
                draw_fib_level(calc_fib_short(h, l, 0.382, use_log), 0.382, "🎯 Тейк-1", pref, color.green, 2, "solid", x_start, x_end, lines_arr, labels_arr)
            draw_fib_level(calc_fib_short(h, l, 0.500, use_log), 0.500, "🔹 Вход в Short (0.500)", pref, color.orange, 2, "solid", x_start, x_end, lines_arr, labels_arr)
            draw_fib_level(calc_fib_short(h, l, 0.618, use_log), 0.618, "🔹 Вход в Short (0.618)", pref, color.red, 2, "solid", x_start, x_end, lines_arr, labels_arr)
            if show_0786
                draw_fib_level(calc_fib_short(h, l, 0.786, use_log), 0.786, "⚡ Вход-3", pref, color.purple, 1, "dotted", x_start, x_end, lines_arr, labels_arr)
            if show_0860
                draw_fib_level(calc_fib_short(h, l, 0.860, use_log), 0.860, "🛑 Стоп Short", pref, color.red, 2, "dashed", x_start, x_end, lines_arr, labels_arr)
            draw_fib_level(calc_fib_short(h, l, 1.000, use_log), 1.000, "🛑 Вершина High", pref, color.maroon, 2, "solid", x_start, x_end, lines_arr, labels_arr)
            if show_manip
                draw_fib_level(calc_fib_short(h, l, 1.618, use_log), 1.618, "🟣 Short Манипуляция", pref, color.fuchsia, 2, "solid", x_start, x_end, lines_arr, labels_arr)
                draw_fib_level(calc_fib_short(h, l, 2.000, use_log), 2.000, "🟠 Добор DCA Short", pref, color.orange, 2, "solid", x_start, x_end, lines_arr, labels_arr)

        // Младшая Short
        bool is_diff_s = na(maj_s_s) or (min_s_s != maj_s_s) or (math.abs(min_s_high - maj_s_high) > 0.0001)
        if show_min and not na(min_s_high) and not na(min_s_low) and is_diff_s
            float h = min_s_high, float l = min_s_low, int x_start = min_s_s
            string pref = "⚡ МЛАДШИЙ SHORT: "
            if show_0382
                draw_fib_level(calc_fib_short(h, l, 0.382, use_log), 0.382, "🎯 Тейк (0.382)", pref, color.lime, 1, "dotted", x_start, x_end, lines_arr, labels_arr)
            draw_fib_level(calc_fib_short(h, l, 0.500, use_log), 0.500, "🔹 Вход (0.500)", pref, color.orange, 2, "solid", x_start, x_end, lines_arr, labels_arr)
            draw_fib_level(calc_fib_short(h, l, 0.618, use_log), 0.618, "🔹 Вход (0.618)", pref, color.red, 2, "solid", x_start, x_end, lines_arr, labels_arr)
            if show_0860
                draw_fib_level(calc_fib_short(h, l, 0.860, use_log), 0.860, "🛑 Стоп (0.860)", pref, color.red, 1, "dashed", x_start, x_end, lines_arr, labels_arr)
            draw_fib_level(calc_fib_short(h, l, 1.000, use_log), 1.000, "🛑 Вершина", pref, color.maroon, 1, "solid", x_start, x_end, lines_arr, labels_arr)
