// ══════════════════════════════════════════════════════════════════════════════
// 2. СТАРШАЯ (ГЛОБАЛЬНАЯ) ФИБА — НАСТРОЙКИ, ЦВЕТА И ТОЛЩИНА
// ══════════════════════════════════════════════════════════════════════════════
grp_maj_set = "🏛️ Старшая Фиба: Поиск и Позиция"
show_maj    = input.bool(false, "Показывать Старшую Фибу (Глобальную)", group=grp_maj_set)
maj_min_p   = input.float(3.0, "Мин. размах Старшей (%)", minval=1.0, step=0.5, group=grp_maj_set)
maj_lookb   = input.int(100, "Глубина поиска Старшей (свечей)", minval=20, maxval=300, group=grp_maj_set)
maj_lbl_pos = input.string("Слева", "Расположение подписей Старшей", options=["Слева", "Справа"], group=grp_maj_set)

grp_maj_col = "🎨 Старшая Фиба: Цвета и Толщина уровней"
col_maj_000 = input.color(color.gray, "0.000 (Top/Bottom)", group=grp_maj_col)
w_maj_000   = input.int(1, "Толщина 0.000", minval=1, maxval=4, group=grp_maj_col)

col_maj_023 = input.color(color.teal, "0.236 (Тейк-2)", group=grp_maj_col)
w_maj_023   = input.int(1, "Толщина 0.236", minval=1, maxval=4, group=grp_maj_col)

col_maj_038 = input.color(color.green, "0.382 (Тейк-1)", group=grp_maj_col)
w_maj_038   = input.int(2, "Толщина 0.382", minval=1, maxval=4, group=grp_maj_col)

col_maj_050 = input.color(#3b82f6, "0.500 (Вход-1)", group=grp_maj_col)
w_maj_050   = input.int(2, "Толщина 0.500", minval=1, maxval=4, group=grp_maj_col)

col_maj_061 = input.color(color.blue, "0.618 (Вход-2)", group=grp_maj_col)
w_maj_061   = input.int(2, "Толщина 0.618", minval=1, maxval=4, group=grp_maj_col)

col_maj_078 = input.color(color.purple, "0.786 (Вход-3)", group=grp_maj_col)
w_maj_078   = input.int(1, "Толщина 0.786", minval=1, maxval=4, group=grp_maj_col)

col_maj_086 = input.color(color.red, "0.860 (Стоп-Лосс)", group=grp_maj_col)
w_maj_086   = input.int(2, "Толщина 0.860", minval=1, maxval=4, group=grp_maj_col)

col_maj_100 = input.color(color.maroon, "1.000 (Дно/Вершина)", group=grp_maj_col)
w_maj_100   = input.int(2, "Толщина 1.000", minval=1, maxval=4, group=grp_maj_col)

col_maj_141 = input.color(#f43f5e, "1.414 (Манипуляция 1)", group=grp_maj_col)
w_maj_141   = input.int(1, "Толщина 1.414", minval=1, maxval=4, group=grp_maj_col)

col_maj_161 = input.color(color.fuchsia, "1.618 (Манипуляция 2)", group=grp_maj_col)
w_maj_161   = input.int(2, "Толщина 1.618", minval=1, maxval=4, group=grp_maj_col)

col_maj_200 = input.color(color.orange, "2.000 (Добор DCA)", group=grp_maj_col)
w_maj_200   = input.int(2, "Толщина 2.000", minval=1, maxval=4, group=grp_maj_col)

// ══════════════════════════════════════════════════════════════════════════════
// 3. МЛАДШАЯ (ЛОКАЛЬНАЯ) ФИБА — НАСТРОЙКИ, ЦВЕТА И ТОЛЩИНА
// ══════════════════════════════════════════════════════════════════════════════
grp_min_set = "⚡ Младшая Фиба: Поиск (Основная)"
show_min    = input.bool(true, "Показывать Младшую Фибу (Локальную)", group=grp_min_set)
min_min_p   = input.float(2.0, "Мин. размах Младшей (%)", minval=0.5, step=0.5, group=grp_min_set)
min_bars    = input.int(4, "Макс. длительность импульса (свечей)", minval=2, maxval=12, tooltip="Сколько свечей длился сам безоткатный каскад. Для SOL и HYPE = 4 свечи", group=grp_min_set)
min_lookb   = input.int(36, "Глубина поиска Младшей (свечей)", minval=10, maxval=100, group=grp_min_set)

grp_min_col = "🎨 Младшая Фиба: Цвета и Толщина уровней"
col_min_038 = input.color(color.lime, "0.382 (Тейк)", group=grp_min_col)
w_min_038   = input.int(1, "Толщина 0.382", minval=1, maxval=4, group=grp_min_col)

col_min_050 = input.color(#06b6d4, "0.500 (Вход)", group=grp_min_col)
w_min_050   = input.int(2, "Толщина 0.500", minval=1, maxval=4, group=grp_min_col)

col_min_061 = input.color(color.yellow, "0.618 (Вход)", group=grp_min_col)
w_min_061   = input.int(2, "Толщина 0.618", minval=1, maxval=4, group=grp_min_col)

col_min_078 = input.color(#c084fc, "0.786 (Глубокий Вход)", group=grp_min_col)
w_min_078   = input.int(1, "Толщина 0.786", minval=1, maxval=4, group=grp_min_col)

col_min_086 = input.color(color.red, "0.860 (Стоп)", group=grp_min_col)
w_min_086   = input.int(1, "Толщина 0.860", minval=1, maxval=4, group=grp_min_col)

col_min_100 = input.color(color.maroon, "1.000 (Дно)", group=grp_min_col)
w_min_100   = input.int(1, "Толщина 1.000", minval=1, maxval=4, group=grp_min_col)

col_min_141 = input.color(#f43f5e, "1.414 (Манипуляция 1)", group=grp_min_col)
w_min_141   = input.int(1, "Толщина 1.414", minval=1, maxval=4, group=grp_min_col)

col_min_161 = input.color(#e879f9, "1.618 (Манипуляция 2)", group=grp_min_col)
w_min_161   = input.int(2, "Толщина 1.618", minval=1, maxval=4, group=grp_min_col)

col_min_200 = input.color(#fb923c, "2.000 (Добор DCA)", group=grp_min_col)
w_min_200   = input.int(2, "Толщина 2.000", minval=1, maxval=4, group=grp_min_col)

// ══════════════════════════════════════════════════════════════════════════════
// 4. ТУМБЛЕРЫ ВКЛЮЧЕНИЯ/ВЫКЛЮЧЕНИЯ УРОВНЕЙ
// ══════════════════════════════════════════════════════════════════════════════
grp_lvls    = "👁️ Включение/Выключение уровней"
show_0236   = input.bool(true, "Показывать 0.236 Fib (Дальний Тейк)", group=grp_lvls)
show_0382   = input.bool(true, "Показывать 0.382 Fib (Базовый Тейк)", group=grp_lvls)
show_0786   = input.bool(true, "Показывать 0.786 Fib (Глубокий Вход)", group=grp_lvls)
show_0860   = input.bool(true, "Показывать 0.860 Fib (Стоп-Лосс)", group=grp_lvls)
show_manip  = input.bool(true, "Показывать 1.414 / 1.618 / 2.000 (Манипуляция)", group=grp_lvls)

// ══════════════════════════════════════════════════════════════════════════════
// 5. МАТЕМАТИЧЕСКИЕ ФУНКЦИИ И ОТРИСОВКА
// ══════════════════════════════════════════════════════════════════════════════
calc_fib_long(float h, float l, float lvl, bool is_log) =>
    if is_log and h > 0 and l > 0
        math.exp(math.log(h) - lvl * (math.log(h) - math.log(l)))
    else
        h - lvl * (h - l)

calc_fib_short(float h, float l, float lvl, bool is_log) =>
    if is_log and h > 0 and l > 0
        math.exp(math.log(l) + lvl * (math.log(h) - math.log(l)))
    else
        l + lvl * (h - l)

draw_level(float price, string label_text, color col, int width, string style_type, int x_start, int x_end, string label_align, line[] lines_arr, label[] labels_arr) =>
    var line_style = line.style_solid
    if style_type == "dashed"
        line_style := line.style_dashed
    else if style_type == "dotted"
        line_style := line.style_dotted

    line ln = line.new(x_start, price, x_end, price, xloc=xloc.bar_index, color=col, width=width, style=line_style)
    array.push(lines_arr, ln)
    
    int lx = label_align == "Слева" ? x_start : x_end
    var l_style = label_align == "Слева" ? label.style_label_right : label.style_label_left
    
    label lb = label.new(lx, price, label_text, xloc=xloc.bar_index, style=l_style, color=color.new(color.black, 100), textcolor=col, size=size.small)
    array.push(labels_arr, lb)

// ══════════════════════════════════════════════════════════════════════════════
// 6. НАДЕЖНЫЙ ПОИСК АКТИВНЫХ ИМПУЛЬСОВ (С ПОДДЕРЖКОЙ МАНИПУЛЯЦИИ ДО 2.000)
// ══════════════════════════════════════════════════════════════════════════════
find_long_impulse(int lookback, float min_pct, int max_duration) =>
    int   best_start = na
    float best_low   = na
    float best_high  = na
    float best_pct   = 0.0
    int   max_s      = math.min(lookback, bar_index)

    if max_s >= 2
        for b = 1 to math.min(40, max_s - 1)
            float h = high[b]
            int   cand_s = na
            float cand_l = low[b]
            float cand_pct = 0.0

            int scan_limit = math.min(b + max_duration, max_s)
            for s = b + 1 to scan_limit
                float l = low[s]
                bool valid_imp = true
                for m = s to b
                    if high[m] > h or low[m] < l
                        valid_imp := false
                        break
                
                if valid_imp
                    float pct = (h - l) / l * 100.0
                    if pct >= min_pct and pct > cand_pct
                        cand_pct := pct
                        cand_s   := s
                        cand_l   := l

            if not na(cand_s)
                float in_050 = calc_fib_long(h, cand_l, 0.500, use_log)
                float tp_038 = calc_fib_long(h, cand_l, 0.382, use_log)
                // Если включена манипуляция, стоп уходит на уровень 2.000, иначе 0.860
                float sl_lim = show_manip ? calc_fib_long(h, cand_l, 2.000, use_log) : calc_fib_long(h, cand_l, 0.860, use_log)

                bool entered  = false
                int  entry_p  = -1
                bool tp_hit   = false
                bool sl_hit   = false

                for p = b - 1 to 0
                    if not entered
                        if low[p] <= in_050
                            entered := true
                            entry_p := p
                        else
                            if high[p] > h or low[p] < sl_lim
                                sl_hit := true
                                break
                    else
                        if p < entry_p
                            if high[p] >= tp_038
                                tp_hit := true
                                break
                            if low[p] <= sl_lim
                                sl_hit := true
                                break

                if not tp_hit and not sl_hit
                    if max_duration <= 12 or cand_pct > best_pct
                        best_pct   := cand_pct
                        best_start := bar_index - cand_s
                        best_low   := cand_l
                        best_high  := h
                        if max_duration <= 12
                            break

    [best_start, best_low, best_high, best_pct]

find_short_impulse(int lookback, float min_pct, int max_duration) =>
    int   best_start = na
    float best_high  = na
    float best_low   = na
    float best_pct   = 0.0
    int   max_s      = math.min(lookback, bar_index)

    if max_s >= 2
        for b = 1 to math.min(40, max_s - 1)
            float l = low[b]
            int   cand_s = na
            float cand_h = high[b]
            float cand_pct = 0.0

            int scan_limit = math.min(b + max_duration, max_s)
            for s = b + 1 to scan_limit
                float h = high[s]
                bool valid_dump = true
                for m = s to b
                    if high[m] > h or low[m] < l
                        valid_dump := false
                        break
                
                if valid_dump
                    float pct = (h - l) / h * 100.0
                    if pct >= min_pct and pct > cand_pct
                        cand_pct := pct
                        cand_s   := s
                        cand_h   := h

            if not na(cand_s)
                float in_050 = calc_fib_short(cand_h, l, 0.500, use_log)
                float tp_038 = calc_fib_short(cand_h, l, 0.382, use_log)
                // Если включена манипуляция, стоп уходит на уровень 2.000, иначе 0.860
                float sl_lim = show_manip ? calc_fib_short(cand_h, l, 2.000, use_log) : calc_fib_short(cand_h, l, 0.860, use_log)

                bool entered  = false
                int  entry_p  = -1
                bool tp_hit   = false
                bool sl_hit   = false

                for p = b - 1 to 0
                    if not entered
                        if high[p] >= in_050
                            entered := true
                            entry_p := p
                        else
                            if high[p] > sl_lim or low[p] < l
                                sl_hit := true
                                break
                    else
                        if p < entry_p
                            if low[p] <= tp_038
                                tp_hit := true
                                break
                            if high[p] >= sl_lim
                                sl_hit := true
                                break

                if not tp_hit and not sl_hit
                    if max_duration <= 12 or cand_pct > best_pct
                        best_pct   := cand_pct
                        best_start := bar_index - cand_s
                        best_high  := cand_h
                        best_low   := l
                        if max_duration <= 12
                            break

    [best_start, best_high, best_low, best_pct]

// ══════════════════════════════════════════════════════════════════════════════
// 7. ОТРИСОВКА СЕТОК НА ГРАФИКЕ
// ══════════════════════════════════════════════════════════════════════════════
var line[] lines_arr   = array.new_line()
var label[] labels_arr = array.new_label()

if barstate.islast
    for ln in lines_arr
        line.delete(ln)
    lines_arr.clear()
    for lb in labels_arr
        label.delete(lb)
    labels_arr.clear()

    // Старшая ищет максимальную глобальную волну (длительность до 200 свечей)
    // Младшая ищет быстрый каскадный импульс (длительность min_bars свечей = 4 по умолчанию)
    [maj_l_s, maj_l_low, maj_l_high, maj_l_pct] = find_long_impulse(maj_lookb, maj_min_p, 200)
    [min_l_s, min_l_low, min_l_high, min_l_pct] = find_long_impulse(min_lookb, min_min_p, min_bars)

    [maj_s_s, maj_s_high, maj_s_low, maj_s_pct] = find_short_impulse(maj_lookb, maj_min_p, 200)
    [min_s_s, min_s_high, min_s_low, min_s_pct] = find_short_impulse(min_lookb, min_min_p, min_bars)

    bool allow_long  = (i_mode == "Только LONG") or (i_mode == "Оба направления (L+S)") or (i_mode == "Авто (по тренду)" and (na(min_s_pct) or min_l_pct >= min_s_pct))
    bool allow_short = (i_mode == "Только SHORT") or (i_mode == "Оба направления (L+S)") or (i_mode == "Авто (по тренду)" and (na(min_l_pct) or min_s_pct > min_l_pct))

    int x_end = bar_index + 16

    // ── 1. LONG СЕТКИ ──
    if allow_long
        // 🏛️ Старшая Long
        if show_maj and not na(maj_l_high) and not na(maj_l_low)
            float h = maj_l_high, float l = maj_l_low, int x_start = maj_l_s
            string pos = maj_lbl_pos
            
            float p000 = calc_fib_long(h, l, 0.000, use_log)
            draw_level(p000, "🏛️ TOP " + str.tostring(p000, "#.###"), col_maj_000, w_maj_000, "dashed", x_start, x_end, pos, lines_arr, labels_arr)
            
            if show_0236
                float p023 = calc_fib_long(h, l, 0.236, use_log)
                draw_level(p023, "🎯 TP-2 (0.236) " + str.tostring(p023, "#.###"), col_maj_023, w_maj_023, "dotted", x_start, x_end, pos, lines_arr, labels_arr)
            if show_0382
                float p038 = calc_fib_long(h, l, 0.382, use_log)
                draw_level(p038, "🎯 TP (0.382) " + str.tostring(p038, "#.###"), col_maj_038, w_maj_038, "solid", x_start, x_end, pos, lines_arr, labels_arr)
            
            float p050 = calc_fib_long(h, l, 0.500, use_log)
            draw_level(p050, "⬆️ 0.500  " + str.tostring(p050, "#.###"), col_maj_050, w_maj_050, "solid", x_start, x_end, pos, lines_arr, labels_arr)
            
            float p061 = calc_fib_long(h, l, 0.618, use_log)
            draw_level(p061, "⬆️ 0.618  " + str.tostring(p061, "#.###"), col_maj_061, w_maj_061, "solid", x_start, x_end, pos, lines_arr, labels_arr)
            
            if show_0786
                float p078 = calc_fib_long(h, l, 0.786, use_log)
                draw_level(p078, "⬆️ 0.786  " + str.tostring(p078, "#.###"), col_maj_078, w_maj_078, "dotted", x_start, x_end, pos, lines_arr, labels_arr)
            if show_0860
                float p086 = calc_fib_long(h, l, 0.860, use_log)
                draw_level(p086, "🛑 SL (0.860) " + str.tostring(p086, "#.###"), col_maj_086, w_maj_086, "dashed", x_start, x_end, pos, lines_arr, labels_arr)
            
            float p100 = calc_fib_long(h, l, 1.000, use_log)
            draw_level(p100, "🛑 LOW (1.0) " + str.tostring(p100, "#.###"), col_maj_100, w_maj_100, "solid", x_start, x_end, pos, lines_arr, labels_arr)
            
            if show_manip
                float p141 = calc_fib_long(h, l, 1.414, use_log)
                float p161 = calc_fib_long(h, l, 1.618, use_log)
                float p200 = calc_fib_long(h, l, 2.000, use_log)
                draw_level(p141, "🔴 1.414  " + str.tostring(p141, "#.###"), col_maj_141, w_maj_141, "solid", x_start, x_end, pos, lines_arr, labels_arr)
                draw_level(p161, "🟣 1.618  " + str.tostring(p161, "#.###"), col_maj_161, w_maj_161, "solid", x_start, x_end, pos, lines_arr, labels_arr)
                draw_level(p200, "🟠 2.000  " + str.tostring(p200, "#.###"), col_maj_200, w_maj_200, "solid", x_start, x_end, pos, lines_arr, labels_arr)

        // ⚡ Младшая Long
        if show_min and not na(min_l_high) and not na(min_l_low)
            float h = min_l_high, float l = min_l_low, int x_start = min_l_s
            
            if show_0382
                float p038 = calc_fib_long(h, l, 0.382, use_log)
                draw_level(p038, "🎯 TP (0.382) " + str.tostring(p038, "#.###"), col_min_038, w_min_038, "dotted", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            float p050 = calc_fib_long(h, l, 0.500, use_log)
            draw_level(p050, "⬆️ 0.500  " + str.tostring(p050, "#.###"), col_min_050, w_min_050, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            float p061 = calc_fib_long(h, l, 0.618, use_log)
            draw_level(p061, "⬆️ 0.618  " + str.tostring(p061, "#.###"), col_min_061, w_min_061, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            if show_0786
                float p078 = calc_fib_long(h, l, 0.786, use_log)
                draw_level(p078, "⬆️ 0.786  " + str.tostring(p078, "#.###"), col_min_078, w_min_078, "dotted", x_start, x_end, "Справа", lines_arr, labels_arr)
            if show_0860
                float p086 = calc_fib_long(h, l, 0.860, use_log)
                draw_level(p086, "🛑 SL (0.860) " + str.tostring(p086, "#.###"), col_min_086, w_min_086, "dashed", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            float p100 = calc_fib_long(h, l, 1.000, use_log)
            draw_level(p100, "🛑 LOW (1.0) " + str.tostring(p100, "#.###"), col_min_100, w_min_100, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            if show_manip
                float p141 = calc_fib_long(h, l, 1.414, use_log)
                float p161 = calc_fib_long(h, l, 1.618, use_log)
                float p200 = calc_fib_long(h, l, 2.000, use_log)
                draw_level(p141, "🔴 1.414  " + str.tostring(p141, "#.###"), col_min_141, w_min_141, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
                draw_level(p161, "🟣 1.618  " + str.tostring(p161, "#.###"), col_min_161, w_min_161, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
                draw_level(p200, "🟠 2.000  " + str.tostring(p200, "#.###"), col_min_200, w_min_200, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)

    // ── 2. SHORT СЕТКИ ──
    if allow_short
        // 🏛️ Старшая Short
        if show_maj and not na(maj_s_high) and not na(maj_s_low)
            float h = maj_s_high, float l = maj_s_low, int x_start = maj_s_s
            string pos = maj_lbl_pos
            
            float p000 = calc_fib_short(h, l, 0.000, use_log)
            draw_level(p000, "🏛️ BOT " + str.tostring(p000, "#.###"), col_maj_000, w_maj_000, "dashed", x_start, x_end, pos, lines_arr, labels_arr)
            
            if show_0236
                float p023 = calc_fib_short(h, l, 0.236, use_log)
                draw_level(p023, "🎯 TP-2 (0.236) " + str.tostring(p023, "#.###"), col_maj_023, w_maj_023, "dotted", x_start, x_end, pos, lines_arr, labels_arr)
            if show_0382
                float p038 = calc_fib_short(h, l, 0.382, use_log)
                draw_level(p038, "🎯 TP (0.382) " + str.tostring(p038, "#.###"), col_maj_038, w_maj_038, "solid", x_start, x_end, pos, lines_arr, labels_arr)
            
            float p050 = calc_fib_short(h, l, 0.500, use_log)
            draw_level(p050, "⬇️ 0.500  " + str.tostring(p050, "#.###"), col_maj_050, w_maj_050, "solid", x_start, x_end, pos, lines_arr, labels_arr)
            
            float p061 = calc_fib_short(h, l, 0.618, use_log)
            draw_level(p061, "⬇️ 0.618  " + str.tostring(p061, "#.###"), col_maj_061, w_maj_061, "solid", x_start, x_end, pos, lines_arr, labels_arr)
            
            if show_0786
                float p078 = calc_fib_short(h, l, 0.786, use_log)
                draw_level(p078, "⬇️ 0.786  " + str.tostring(p078, "#.###"), col_maj_078, w_maj_078, "dotted", x_start, x_end, pos, lines_arr, labels_arr)
            if show_0860
                float p086 = calc_fib_short(h, l, 0.860, use_log)
                draw_level(p086, "🛑 SL (0.860) " + str.tostring(p086, "#.###"), col_maj_086, w_maj_086, "dashed", x_start, x_end, pos, lines_arr, labels_arr)
            
            float p100 = calc_fib_short(h, l, 1.000, use_log)
            draw_level(p100, "🛑 HIGH (1.0) " + str.tostring(p100, "#.###"), col_maj_100, w_maj_100, "solid", x_start, x_end, pos, lines_arr, labels_arr)
            
            if show_manip
                float p141 = calc_fib_short(h, l, 1.414, use_log)
                float p161 = calc_fib_short(h, l, 1.618, use_log)
                float p200 = calc_fib_short(h, l, 2.000, use_log)
                draw_level(p141, "🔴 1.414  " + str.tostring(p141, "#.###"), col_maj_141, w_maj_141, "solid", x_start, x_end, pos, lines_arr, labels_arr)
                draw_level(p161, "🟣 1.618  " + str.tostring(p161, "#.###"), col_maj_161, w_maj_161, "solid", x_start, x_end, pos, lines_arr, labels_arr)
                draw_level(p200, "🟠 2.000  " + str.tostring(p200, "#.###"), col_maj_200, w_maj_200, "solid", x_start, x_end, pos, lines_arr, labels_arr)

        // ⚡ Младшая Short
        if show_min and not na(min_s_high) and not na(min_s_low)
            float h = min_s_high, float l = min_s_low, int x_start = min_s_s
            
            if show_0382
                float p038 = calc_fib_short(h, l, 0.382, use_log)
                draw_level(p038, "🎯 TP (0.382) " + str.tostring(p038, "#.###"), col_min_038, w_min_038, "dotted", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            float p050 = calc_fib_short(h, l, 0.500, use_log)
            draw_level(p050, "⬇️ 0.500  " + str.tostring(p050, "#.###"), col_min_050, w_min_050, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            float p061 = calc_fib_short(h, l, 0.618, use_log)
            draw_level(p061, "⬇️ 0.618  " + str.tostring(p061, "#.###"), col_min_061, w_min_061, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            if show_0786
                float p078 = calc_fib_short(h, l, 0.786, use_log)
                draw_level(p078, "⬇️ 0.786  " + str.tostring(p078, "#.###"), col_min_078, w_min_078, "dotted", x_start, x_end, "Справа", lines_arr, labels_arr)
            if show_0860
                float p086 = calc_fib_short(h, l, 0.860, use_log)
                draw_level(p086, "🛑 SL (0.860) " + str.tostring(p086, "#.###"), col_min_086, w_min_086, "dashed", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            float p100 = calc_fib_short(h, l, 1.000, use_log)
            draw_level(p100, "🛑 HIGH (1.0) " + str.tostring(p100, "#.###"), col_min_100, w_min_100, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
            
            if show_manip
                float p141 = calc_fib_short(h, l, 1.414, use_log)
                float p161 = calc_fib_short(h, l, 1.618, use_log)
                float p200 = calc_fib_short(h, l, 2.000, use_log)
                draw_level(p141, "🔴 1.414  " + str.tostring(p141, "#.###"), col_min_141, w_min_141, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
                draw_level(p161, "🟣 1.618  " + str.tostring(p161, "#.###"), col_min_161, w_min_161, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
                draw_level(p200, "🟠 2.000  " + str.tostring(p200, "#.###"), col_min_200, w_min_200, "solid", x_start, x_end, "Справа", lines_arr, labels_arr)
