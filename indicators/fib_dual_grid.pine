//@version=6
indicator("Fibonacci Dual Grid (Pro Live Only)", shorttitle="Fib Dual Grid Pro v6", overlay=true, max_lines_count=500, max_labels_count=500)

// ══════════════════════════════════════════════════════════════════════════════
// 1. ОБЩИЕ НАСТРОЙКИ
// ══════════════════════════════════════════════════════════════════════════════
grp_gen    = "⚙️ Общие настройки"
i_mode     = input.string("Авто (по тренду)", "Режим торговли", options=["Авто (по тренду)", "Только LONG", "Только SHORT", "Оба направления (L+S)"], group=grp_gen)
