//@version=6
indicator("Манипуляция на часе (Mon 1H) — Сетка Фибо и Сигналы", shorttitle="Mon 1H Strategy", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ─── 1. Настройки ────────────────────────────────────────────────────────────
group_imp     = "1. Параметры Импульса"
min_imp_pct   = input.float(2.0, "Мин. размер импульса (%)", minval=0.5, step=0.1, group=group_imp)
shadow_check  = input.bool(true, "Проверка тени 0.5 Fib при формировании", group=group_imp)

group_mode    = "2. Торговые Режимы"
enable_long   = input.bool(true, "Сигналы LONG", group=group_mode)
enable_short  = input.bool(true, "Сигналы SHORT (Обычный)", group=group_mode)
enable_manip  = input.bool(true, "Сценарий Манипуляции (1.618 / 2.0)", group=group_mode)

group_levels  = "3. Уровни Тейк-Профита и Стопа"
normal_sl_fib = input.float(0.764, "Стоп-Лосс для обычного отскока (Fib)", group=group_levels)
manip_tp_fib  = input.float(0.500, "Тейк-Профит Манипуляции (Fib)", group=group_levels)

group_visual  = "4. Визуализация и Сетка"
show_fib_grid = input.bool(true, "Показывать сетку Фибоначчи и подписи уровней", group=group_visual)
show_labels   = input.bool(true, "Показывать стрелки и карточки входа", group=group_visual)
extend_bars   = input.int(25, "Длина линий Фибо вперед (баров)", minval=5, maxval=100, group=group_visual)

// ─── Цвета ───────────────────────────────────────────────────────────────────
c_bull = color.green
c_bear = color.red
c_dca  = color.orange

// ─── Детектор восходящего импульса (LONG) ────────────────────────────────────
var int   l_start_idx = na
var int   l_end_idx   = na
var float l_high      = na
var float l_low       = na
var bool  l_building  = false

fib_l(float h, float l, float lvl) => h - lvl * (h - l)

if ta.crossover(high, high[1]) and not l_building
    if high > high[1] and low[1] > 0
        l_start_idx := bar_index - 1
        l_low       := low[1]
        l_high      := high
        l_end_idx   := bar_index
        l_building  := true

if l_building
    if high > l_high
        float cur_05 = fib_l(high, l_low, 0.500)
        if not shadow_check or low > cur_05
            l_high    := high
            l_end_idx := bar_index
        else
            l_building := false
    else
        float final_05 = fib_l(l_high, l_low, 0.500)
        if low <= final_05
            l_building := false

bool is_new_long_imp = not l_building and not na(l_high) and not na(l_low) and ((l_high - l_low) / l_low * 100.0 >= min_imp_pct)

// ─── Детектор нисходящего импульса (SHORT) ───────────────────────────────────
var int   s_start_idx = na
var int   s_end_idx   = na
var float s_high      = na
var float s_low       = na
var bool  s_building  = false

fib_s(float h, float l, float lvl) => l + lvl * (h - l)

if ta.crossunder(low, low[1]) and not s_building
    if low < low[1] and high[1] > 0
        s_start_idx := bar_index - 1
        s_high      := high[1]
        s_low       := low
        s_end_idx   := bar_index
        s_building  := true

if s_building
    if low < s_low
        float cur_05 = fib_s(s_high, low, 0.500)
        if not shadow_check or high < cur_05
            s_low     := low
            s_end_idx := bar_index
        else
            s_building := false
    else
        float final_05 = fib_s(s_high, s_low, 0.500)
        if high >= final_05
            s_building := false

bool is_new_short_imp = not s_building and not na(s_high) and not na(s_low) and ((s_high - s_low) / s_high * 100.0 >= min_imp_pct)

// ─── Расчет уровней Фибоначчи ────────────────────────────────────────────────
// LONG уровни
float lp0    = l_high
float lp382  = fib_l(l_high, l_low, 0.382)
float lp500  = fib_l(l_high, l_low, 0.500)
float lp618  = fib_l(l_high, l_low, 0.618)
float lpsl   = fib_l(l_high, l_low, normal_sl_fib)
float lp100  = l_low
float lp1618 = fib_l(l_high, l_low, 1.618)
float lp2000 = fib_l(l_high, l_low, 2.000)
float lpmtp  = fib_l(l_high, l_low, manip_tp_fib)

// SHORT уровни
float sp0    = s_low
float sp382  = fib_s(s_high, s_low, 0.382)
float sp500  = fib_s(s_high, s_low, 0.500)
float sp618  = fib_s(s_high, s_low, 0.618)
float spsl   = fib_s(s_high, s_low, normal_sl_fib)
float sp100  = s_high

// ─── Отрисовка Фибо-сетки на основном графике ─────────────────────────────────
var line[] fib_lines = array.new_line()
var label[] fib_labels = array.new_label()

// Функция для добавления линии с подписью цены и уровня
add_fib_level(int x1, int x2, float price, string name, color col, int width, string l_style) =>
    line_st = l_style == "dashed" ? line.style_dashed : (l_style == "dotted" ? line.style_dotted : line.style_solid)
    l = line.new(x1, price, x2, price, color=col, width=width, style=line_st)
    lbl = label.new(x2, price, name + " (" + str.tostring(price, "#.##") + ")", 
                    style=label.style_label_left, color=color.new(color.black, 100), 
                    textcolor=col, size=size.small)
    array.push(fib_lines, l)
    array.push(fib_labels, lbl)

clear_fib_grid() =>
    if array.size(fib_lines) > 0
        for i = 0 to array.size(fib_lines) - 1
            line.delete(array.get(fib_lines, i))
        array.clear(fib_lines)
    if array.size(fib_labels) > 0
        for i = 0 to array.size(fib_labels) - 1
            label.delete(array.get(fib_labels, i))
        array.clear(fib_labels)

// Отрисовываем сетку последнего подтвержденного импульса
if show_fib_grid and (is_new_long_imp or (not na(l_start_idx) and bar_index % 15 == 0))
    clear_fib_grid()
    int x1 = l_start_idx
    int x2 = bar_index + extend_bars
    
    add_fib_level(x1, x2, lp0,    "0.000 — TOP (High)", color.gray, 1, "dashed")
    add_fib_level(x1, x2, lp382,  "0.382 — TP для 0.500", color.teal, 1, "dotted")
    add_fib_level(x1, x2, lp500,  "0.500 — ТЕЙК-ПРОФИТ (TP)", color.green, 2, "solid")
    add_fib_level(x1, x2, lp618,  "0.618 — ВХОД LONG", color.blue, 2, "solid")
    add_fib_level(x1, x2, lpsl,   "0.764 — СТОП-ЛОСС (SL)", color.red, 1, "dashed")
    add_fib_level(x1, x2, lp100,  "1.000 — Дно Импульса", color.maroon, 1, "solid")
    if enable_manip
        add_fib_level(x1, x2, lp1618, "1.618 — ВХОД МАНИПУЛЯЦИЯ (1 лот)", color.purple, 2, "solid")
        add_fib_level(x1, x2, lp2000, "2.000 — ДОБОР DCA (2 лота)", c_dca, 2, "solid")

// ─── Торговые Сигналы ────────────────────────────────────────────────────────
bool sig_long_normal = enable_long and is_new_long_imp and ta.crossunder(low, lp618) and low > lpsl
bool sig_long_manip1 = enable_long and enable_manip and is_new_long_imp and ta.crossunder(low, lp1618)
bool sig_long_dca    = enable_long and enable_manip and is_new_long_imp and ta.crossunder(low, lp2000)
bool sig_long_tp     = enable_long and ta.crossover(high, lp500)
bool sig_long_sl     = enable_long and ta.crossunder(low, lpsl)

bool sig_short_normal= enable_short and is_new_short_imp and ta.crossover(high, sp618) and high < spsl
bool sig_short_tp    = enable_short and ta.crossunder(low, sp500)
bool sig_short_sl    = enable_short and ta.crossover(high, spsl)

// ─── Визуальные стрелки и метки на свечах ────────────────────────────────────
plotshape(show_labels and sig_long_normal, title="Вход LONG 0.618", style=shape.triangleup, location=location.belowbar, color=color.blue, size=size.normal, text="LONG 0.618")
plotshape(show_labels and sig_long_manip1, title="Вход Манипуляция 1.618", style=shape.triangleup, location=location.belowbar, color=color.purple, size=size.large, text="МАНИПУЛЯЦИЯ\n1.618")
plotshape(show_labels and sig_long_dca,    title="Добор 2.000 DCA", style=shape.triangleup, location=location.belowbar, color=c_dca, size=size.large, text="DCA 2.0 (2x)")

plotshape(show_labels and sig_short_normal,title="Вход SHORT 0.618", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.normal, text="SHORT 0.618")

plotshape(show_labels and sig_long_tp,     title="Take Profit", style=shape.circle, location=location.abovebar, color=color.green, size=size.small, text="TP")
plotshape(show_labels and sig_long_sl,     title="Stop Loss", style=shape.xcross, location=location.belowbar, color=color.red, size=size.small, text="SL")

// Подробная всплывающая карточка для входа
if show_labels and sig_long_normal
    label.new(bar_index, low, "🟢 LONG ВХОД: " + str.tostring(lp618, "#.##") + "\n🎯 TP (0.500): " + str.tostring(lp500, "#.##") + "\n🛑 SL (0.764): " + str.tostring(lpsl, "#.##"), 
              style=label.style_label_up, color=color.new(color.blue, 10), textcolor=color.white, size=size.small)

if show_labels and sig_long_manip1
    label.new(bar_index, low, "🟣 МАНИПУЛЯЦИЯ ВХОД: " + str.tostring(lp1618, "#.##") + "\n🎯 ТЕЙК (0.500): " + str.tostring(lp500, "#.##") + "\n📦 ДОБОР (2.000): " + str.tostring(lp2000, "#.##"), 
              style=label.style_label_up, color=color.new(color.purple, 10), textcolor=color.white, size=size.small)

// ─── Оповещения (TradingView Alerts) ─────────────────────────────────────────
alertcondition(sig_long_normal,  "1. LONG Вход 0.618", "🟢 Вход в LONG на 0.618 Fib: {{ticker}} @ {{close}} | TP: 0.500, SL: 0.764")
alertcondition(sig_long_manip1,  "2. LONG Манипуляция 1.618", "🟣 Вход Манипуляция на 1.618 Fib: {{ticker}} @ {{close}} | TP: 0.500")
alertcondition(sig_long_dca,     "3. LONG Добор DCA 2.000", "🟠 Добор позиции DCA на 2.000 Fib (2x лота): {{ticker}} @ {{close}}")
alertcondition(sig_short_normal, "4. SHORT Вход 0.618", "🔴 Вход в SHORT на 0.618 Fib: {{ticker}} @ {{close}} | TP: 0.500")
alertcondition(sig_long_tp or sig_short_tp, "5. Take Profit", "🎯 Сработал Take Profit: {{ticker}} @ {{close}}")
alertcondition(sig_long_sl or sig_short_sl, "6. Stop Loss", "🛑 Сработал Stop Loss: {{ticker}} @ {{close}}")
