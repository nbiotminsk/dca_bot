//@version=6
indicator("Манипуляция на часе (Clean & Minimal)", shorttitle="Mon 1H Clean", overlay=true, max_lines_count=100, max_labels_count=100)

// ─── Настройки ───────────────────────────────────────────────────────────────
min_imp_pct   = input.float(2.0, "Мин. размах импульса (%)", minval=0.5, step=0.1)
show_fib_grid = input.bool(true, "Отображать сетку Фибоначчи")
show_normal   = input.bool(true, "Сигналы Обычного отскока (0.618)")
show_manip    = input.bool(true, "Сигналы Манипуляции (1.618)")

// ─── Функции расчета Фибоначчи ───────────────────────────────────────────────
fib_l(float h, float l, float lvl) => h - lvl * (h - l)
fib_s(float h, float l, float lvl) => l + lvl * (h - l)

// ─── Детектор импульса LONG ──────────────────────────────────────────────────
var int   l_start = na
var float l_high  = na
var float l_low   = na
var bool  l_act   = false

if ta.crossover(high, high[1]) and not l_act
    if high > high[1] and low[1] > 0
        l_start := bar_index - 1
        l_low   := low[1]
        l_high  := high
        l_act   := true

if l_act
    if high > l_high
        float c05 = fib_l(high, l_low, 0.500)
        if low > c05
            l_high := high
        else
            l_act := false
    else
        float f05 = fib_l(l_high, l_low, 0.500)
        if low <= f05
            l_act := false

bool is_long_imp = not l_act and not na(l_high) and not na(l_low) and ((l_high - l_low) / l_low * 100.0 >= min_imp_pct)

// ─── Детектор импульса SHORT ─────────────────────────────────────────────────
var int   s_start = na
var float s_high  = na
var float s_low   = na
var bool  s_act   = false

if ta.crossunder(low, low[1]) and not s_act
    if low < low[1] and high[1] > 0
        s_start := bar_index - 1
        s_high  := high[1]
        s_low   := low
        s_act   := true

if s_act
    if low < s_low
        float c05 = fib_s(s_high, low, 0.500)
        if high < c05
            s_low := low
        else
            s_act := false
    else
        float f05 = fib_s(s_high, s_low, 0.500)
        if high >= f05
            s_act := false

bool is_short_imp = not s_act and not na(s_high) and not na(s_low) and ((s_high - s_low) / s_high * 100.0 >= min_imp_pct)

// ─── Уровни цен ──────────────────────────────────────────────────────────────
float lp500  = fib_l(l_high, l_low, 0.500)
float lp618  = fib_l(l_high, l_low, 0.618)
float lpsl   = fib_l(l_high, l_low, 0.764)
float lp100  = l_low
float lp1618 = fib_l(l_high, l_low, 1.618)
float lp2000 = fib_l(l_high, l_low, 2.000)

float sp500  = fib_s(s_high, s_low, 0.500)
float sp618  = fib_s(s_high, s_low, 0.618)
float spsl   = fib_s(s_high, s_low, 0.764)

// ─── Состояния сделок (для исключения спама меток) ──────────────────────────
var bool long_normal_in = false
var bool manip_in       = false
var bool manip_dca_in   = false
var bool short_in       = false

// 1. LONG Normal
bool buy_long_normal = show_normal and is_long_imp and not long_normal_in and ta.crossunder(low, lp618) and low > lpsl
if buy_long_normal
    long_normal_in := true

bool tp_long_normal  = long_normal_in and ta.crossover(high, lp500)
bool sl_long_normal  = long_normal_in and ta.crossunder(low, lpsl)
if tp_long_normal or sl_long_normal
    long_normal_in := false

// 2. LONG Manipulation
bool buy_manip = show_manip and is_long_imp and not manip_in and ta.crossunder(low, lp1618)
if buy_manip
    manip_in := true

bool buy_manip_dca = show_manip and manip_in and not manip_dca_in and ta.crossunder(low, lp2000)
if buy_manip_dca
    manip_dca_in := true

bool tp_manip = manip_in and ta.crossover(high, lp500)
if tp_manip
    manip_in     := false
    manip_dca_in := false

// 3. SHORT Normal
bool buy_short = show_normal and is_short_imp and not short_in and ta.crossover(high, sp618) and high < spsl
if buy_short
    short_in := true

bool tp_short = short_in and ta.crossunder(low, sp500)
bool sl_short = short_in and ta.crossover(high, spsl)
if tp_short or sl_short
    short_in := false

// ─── Отрисовка ОДНОЙ чистой сетки Фибоначчи ──────────────────────────────────
var line l0    = na, var line l500  = na, var line l618  = na, var line lsl   = na, var line l100  = na, var line l1618 = na, var line l2000 = na
var label lbl500 = na, var label lbl618 = na, var label lblsl = na, var label lbl1618 = na, var label lbl2000 = na

if show_fib_grid and (is_long_imp or (not na(l_start) and bar_index % 10 == 0))
    // Удаляем предыдущую сетку, чтобы график был идеально чистым
    line.delete(l0), line.delete(l500), line.delete(l618), line.delete(lsl), line.delete(l100), line.delete(l1618), line.delete(l2000)
    label.delete(lbl500), label.delete(lbl618), label.delete(lblsl), label.delete(lbl1618), label.delete(lbl2000)
    
    int x1 = l_start
    int x2 = bar_index + 15
    
    l0    := line.new(x1, l_high, x2, l_high, color=color.new(color.gray, 60), width=1, style=line.style_dashed)
    l500  := line.new(x1, lp500,  x2, lp500,  color=color.green, width=2)
    l618  := line.new(x1, lp618,  x2, lp618,  color=color.blue,  width=2)
    lsl   := line.new(x1, lpsl,   x2, lpsl,   color=color.red,   width=1, style=line.style_dashed)
    l100  := line.new(x1, lp100,  x2, lp100,  color=color.maroon,width=1)
    
    lbl500 := label.new(x2, lp500, "0.500 TP (" + str.tostring(lp500, "#.##") + ")", style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.green, size=size.small)
    lbl618 := label.new(x2, lp618, "0.618 Вход (" + str.tostring(lp618, "#.##") + ")", style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.blue, size=size.small)
    lblsl  := label.new(x2, lpsl,  "0.764 SL (" + str.tostring(lpsl, "#.##") + ")", style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.red, size=size.small)
    
    if show_manip
        l1618 := line.new(x1, lp1618, x2, lp1618, color=color.purple, width=2)
        l2000 := line.new(x1, lp2000, x2, lp2000, color=color.orange, width=2)
        lbl1618 := label.new(x2, lp1618, "1.618 Манипуляция (" + str.tostring(lp1618, "#.##") + ")", style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.purple, size=size.small)
        lbl2000 := label.new(x2, lp2000, "2.000 Добор DCA (" + str.tostring(lp2000, "#.##") + ")", style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.orange, size=size.small)

// ─── Аккуратные маркеры на графике (без мусора) ──────────────────────────────
plotshape(buy_long_normal, title="Вход 0.618", style=shape.labelup, location=location.belowbar, color=color.blue, text="BUY 0.618", textcolor=color.white, size=size.small)
plotshape(buy_manip,       title="Манипуляция 1.618", style=shape.labelup, location=location.belowbar, color=color.purple, text="МАНИПУЛЯЦИЯ 1.618", textcolor=color.white, size=size.small)
plotshape(buy_manip_dca,   title="Добор 2.0 DCA", style=shape.labelup, location=location.belowbar, color=color.orange, text="ДОБОР 2.0 (2x)", textcolor=color.black, size=size.small)
plotshape(buy_short,       title="SHORT 0.618", style=shape.labeldown, location=location.abovebar, color=color.red, text="SHORT 0.618", textcolor=color.white, size=size.small)

plotshape(tp_long_normal or tp_manip or tp_short, title="Тейк-профит", style=shape.circle, location=location.abovebar, color=color.green, text="TP", textcolor=color.white, size=size.tiny)
plotshape(sl_long_normal or sl_short, title="Стоп-лосс", style=shape.cross, location=location.belowbar, color=color.red, text="SL", textcolor=color.white, size=size.tiny)

// ─── Оповещения (Alerts) ─────────────────────────────────────────────────────
alertcondition(buy_long_normal, "LONG 0.618", "LONG 0.618: {{ticker}} @ {{close}} | TP: 0.500, SL: 0.764")
alertcondition(buy_manip,       "Манипуляция 1.618", "Манипуляция 1.618: {{ticker}} @ {{close}} | TP: 0.500")
alertcondition(buy_manip_dca,   "Добор 2.0", "Добор DCA 2.0: {{ticker}} @ {{close}}")
alertcondition(buy_short,       "SHORT 0.618", "SHORT 0.618: {{ticker}} @ {{close}} | TP: 0.500")
alertcondition(tp_long_normal or tp_manip or tp_short, "Take Profit", "TP: {{ticker}} @ {{close}}")
alertcondition(sl_long_normal or sl_short, "Stop Loss", "SL: {{ticker}} @ {{close}}")
