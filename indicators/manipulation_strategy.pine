//@version=6
indicator("Манипуляция на часе (Mon 1H) — Сетка Фибо и Сигналы", shorttitle="Mon 1H Log/Lin Fib", overlay=true, max_lines_count=100, max_labels_count=100)

// ─── 1. Настройки ────────────────────────────────────────────────────────────
use_log_scale = input.bool(true, "Использовать ЛОГАРИФМИЧЕСКУЮ шкалу Фибо (Log Fib)", group="Режим шкалы")
min_imp_pct   = input.float(2.0, "Мин. размах импульса (%)", minval=0.5, step=0.1, group="Импульс")
shadow_check  = input.bool(true, "Проверка тени 0.5 Fib при расширении", group="Импульс")
normal_sl_fib = input.float(0.764, "Стоп-Лосс обычного сценария (Fib)", group="Уровни")
show_manip    = input.bool(true, "Показывать уровни Манипуляции (1.618 / 2.0)", group="Уровни")

// ─── Функция расчета уровня Фибоначчи (Линейная + Логарифмическая) ─────────
fib_l(float h, float l, float lvl, bool is_log) =>
    if is_log and h > 0 and l > 0
        math.exp(math.log(h) - lvl * (math.log(h) - math.log(l)))
    else
        h - lvl * (h - l)

// ─── Сканер Самого Свежего Актуального Импульса ──────────────────────────────
var int   last_imp_start = na
var int   last_imp_end   = na
var float last_imp_high  = na
var float last_imp_low   = na

find_latest_impulse() =>
    int   f_start = na
    int   f_end   = na
    float f_high  = na
    float f_low   = na
    
    for i = 1 to 60
        if high[i] > high[i+1] and low[i+1] > 0
            float cur_low  = low[i+1]
            float cur_high = high[i]
            int   cur_start= bar_index - (i + 1)
            int   cur_end  = bar_index - i
            
            bool valid_extension = true
            for j = i - 1 to 0
                if high[j] > cur_high
                    float prev_05 = fib_l(cur_high, cur_low, 0.500, use_log_scale)
                    if shadow_check and low[j] <= prev_05
                        valid_extension := false
                        break
                    cur_high := high[j]
                    cur_end  := bar_index - j
                else
                    float cur_05 = fib_l(cur_high, cur_low, 0.500, use_log_scale)
                    if low[j] <= cur_05
                        break
                        
            float pct = (cur_high - cur_low) / cur_low * 100.0
            if pct >= min_imp_pct and cur_end > cur_start
                f_start := cur_start
                f_end   := cur_end
                f_high  := cur_high
                f_low   := cur_low
                break
                
    [f_start, f_end, f_high, f_low]

[cur_start, cur_end, cur_high, cur_low] = find_latest_impulse()

if not na(cur_high) and not na(cur_low)
    last_imp_start := cur_start
    last_imp_end   := cur_end
    last_imp_high  := cur_high
    last_imp_low   := cur_low

// ─── Расчет уровней Фибоначчи АКТУАЛЬНОГО импульса ────────────────────────────
float p0    = last_imp_high
float p382  = fib_l(last_imp_high, last_imp_low, 0.382, use_log_scale)
float p500  = fib_l(last_imp_high, last_imp_low, 0.500, use_log_scale)
float p618  = fib_l(last_imp_high, last_imp_low, 0.618, use_log_scale)
float psl   = fib_l(last_imp_high, last_imp_low, normal_sl_fib, use_log_scale)
float p100  = last_imp_low
float p1618 = fib_l(last_imp_high, last_imp_low, 1.618, use_log_scale)
float p2000 = fib_l(last_imp_high, last_imp_low, 2.000, use_log_scale)

// ─── Отрисовка Живой Сетки Фибоначчи ──────────────────────────────────────────
var line l0    = na, var line l500  = na, var line l618  = na, var line lsl   = na, var line l100  = na, var line l1618 = na, var line l2000 = na
var label lbl0 = na, var label lbl500 = na, var label lbl618 = na, var label lblsl = na, var label lbl100 = na, var label lbl1618 = na, var label lbl2000 = na

if not na(last_imp_high) and not na(last_imp_low)
    line.delete(l0), line.delete(l500), line.delete(l618), line.delete(lsl), line.delete(l100), line.delete(l1618), line.delete(l2000)
    label.delete(lbl0), label.delete(lbl500), label.delete(lbl618), label.delete(lblsl), label.delete(lbl100), label.delete(lbl1618), label.delete(lbl2000)
    
    int x1 = last_imp_start
    int x2 = bar_index + 12
    
    string scale_tag = use_log_scale ? " (Log)" : ""
    
    // 0.000 TOP
    l0    := line.new(x1, p0, x2, p0, color=color.gray, width=1, style=line.style_dashed)
    lbl0  := label.new(x2, p0, "0.000 TOP (" + str.tostring(p0, "#.##") + ")", style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.gray, size=size.small)
    
    // 0.500 ТЕЙК
    l500  := line.new(x1, p500, x2, p500, color=color.green, width=2)
    lbl500:= label.new(x2, p500, "0.500 ТЕЙК" + scale_tag + " (" + str.tostring(p500, "#.##") + ")", style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.green, size=size.small)
    
    // 0.618 ВХОД
    l618  := line.new(x1, p618, x2, p618, color=color.blue, width=2)
    lbl618:= label.new(x2, p618, "0.618 ВХОД" + scale_tag + " (" + str.tostring(p618, "#.##") + ")", style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.blue, size=size.small)
    
    // 0.764 СТОП
    lsl   := line.new(x1, psl, x2, psl, color=color.red, width=1, style=line.style_dashed)
    lblsl := label.new(x2, psl, "0.764 СТОП" + scale_tag + " (" + str.tostring(psl, "#.##") + ")", style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.red, size=size.small)
    
    // 1.000 ДНО ИМПУЛЬСА
    l100  := line.new(x1, p100, x2, p100, color=color.maroon, width=2)
    lbl100:= label.new(x2, p100, "1.000 ДНО (" + str.tostring(p100, "#.##") + ")", style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.maroon, size=size.small)
    
    if show_manip
        // 1.618 МАНИПУЛЯЦИЯ
        l1618 := line.new(x1, p1618, x2, p1618, color=color.purple, width=2)
        lbl1618 := label.new(x2, p1618, "1.618 МАНИПУЛЯЦИЯ (" + str.tostring(p1618, "#.##") + ")", style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.purple, size=size.small)
        
        // 2.000 ДОБОР DCA
        l2000 := line.new(x1, p2000, x2, p2000, color=color.orange, width=2)
        lbl2000 := label.new(x2, p2000, "2.000 ДОБОР DCA (" + str.tostring(p2000, "#.##") + ")", style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.orange, size=size.small)

// ─── Сигналы на свечах ───────────────────────────────────────────────────────
var bool in_pos_normal = false
var bool in_pos_manip  = false
var bool in_pos_dca    = false

bool buy_normal = not in_pos_normal and ta.crossunder(low, p618) and low > psl
if buy_normal
    in_pos_normal := true

bool tp_normal  = in_pos_normal and ta.crossover(high, p500)
bool sl_normal  = in_pos_normal and ta.crossunder(low, psl)
if tp_normal or sl_normal
    in_pos_normal := false

bool buy_m1 = show_manip and not in_pos_manip and ta.crossunder(low, p1618)
if buy_m1
    in_pos_manip := true

bool buy_m2 = show_manip and in_pos_manip and not in_pos_dca and ta.crossunder(low, p2000)
if buy_m2
    in_pos_dca := true

bool tp_m = in_pos_manip and ta.crossover(high, p500)
if tp_m
    in_pos_manip := false
    in_pos_dca   := false

plotshape(buy_normal, title="BUY 0.618", style=shape.labelup, location=location.belowbar, color=color.blue, text="BUY 0.618", textcolor=color.white, size=size.small)
plotshape(buy_m1,     title="МАНИПУЛЯЦИЯ 1.618", style=shape.labelup, location=location.belowbar, color=color.purple, text="МАНИПУЛЯЦИЯ 1.618", textcolor=color.white, size=size.small)
plotshape(buy_m2,     title="ДОБОР 2.0 DCA", style=shape.labelup, location=location.belowbar, color=color.orange, text="ДОБОР 2.0 (2x)", textcolor=color.black, size=size.small)

plotshape(tp_normal or tp_m, title="TP", style=shape.circle, location=location.abovebar, color=color.green, text="TP", textcolor=color.white, size=size.tiny)
plotshape(sl_normal, title="SL", style=shape.cross, location=location.belowbar, color=color.red, text="SL", textcolor=color.white, size=size.tiny)
